---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DataTable from "@/components/app/ui/DataTable.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { PaymentMethodRepository } from "@/lib/modules/payment-methods/repository.ts";
const userId = Astro.locals.userId;
const repo = new PaymentMethodRepository();
const items = await repo.findAll(userId);
const typeLabels: Record<string, string> = {
  global: "Global",
  personal: "Personal",
  card: "Tarjeta",
};
const typeColors: Record<string, string> = {
  global: "bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300",
  personal: "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300",
  card: "bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300",
};
const fields = [
  { name: "name", label: "Nombre", type: "text" as const, required: true },
  { name: "icon", label: "Ícono (emoji)", type: "text" as const, placeholder: "💳" },
  { name: "color", label: "Color", type: "color" as const },
];
const defaultForm = { name: "", type: "personal", icon: "💳", color: "#6366f1" };
---

<AppLayout title="Métodos de pago - Open PRP">
  <div data-module="payment-methods" class="space-y-4">
    <PageHeader title="Métodos de pago" createLabel="Nuevo método" createModule="payment-methods" />
    <DataTable columns={["Nombre", "Tipo", { label: "Icono", align: "center" }, "Color", { label: "Acciones", align: "right" }]} emptyMessage="Sin métodos de pago">
      {items.map(m => {
        const isSystem = m.type === "global" || m.type === "card";
        return (
        <tr key={m.id} class="hover:bg-nav-hover">
          <td class="px-4 py-3 font-medium">{m.name}</td>
          <td class="px-4 py-3"><span class={`text-xs font-medium px-2 py-0.5 rounded ${typeColors[m.type] || "bg-surface-alt text-string-muted"}`}>{typeLabels[m.type] || m.type}</span></td>
          <td class="px-4 py-3 text-center">{m.icon || "-"}</td>
          <td class="px-4 py-3">
            <span class="inline-block w-5 h-5 rounded-full border border-border" style={{ backgroundColor: m.color || "#6366f1" }} />
          </td>
          <td class="px-4 py-3 text-right space-x-2">
            {!isSystem && <>
              <button data-edit-payment-methods={m.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">Editar</button>
              <button data-delete-payment-methods={m.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">Eliminar</button>
            </>}
          </td>
        </tr>
      );})}
    </DataTable>
  </div>
  <CrudModal client:load module="payment-methods" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="método de pago" />
  <DeleteHandler module="payment-methods" label="método de pago" />
</AppLayout>
