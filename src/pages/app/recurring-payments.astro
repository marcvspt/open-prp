---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DataTable from "@/components/app/ui/DataTable.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import RecurringPaymentsMonthly from "@/components/app/recurring-payments/RecurringPaymentsMonthly.tsx";
import RecurringPaymentsHistory from "@/components/app/recurring-payments/RecurringPaymentsHistory.tsx";
import { RecurringPaymentRepository } from "@/lib/modules/recurring-payments/repository.ts";
import { RecurringPaymentMonthlyRepository } from "@/lib/modules/recurring-payment-monthly/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { PaymentMethodRepository } from "@/lib/modules/payment-methods/repository.ts";
import { FIELD_TYPE_CURRENCY, FIELD_TYPE, paymentMethodField, categoryField, CURRENCY_SYMBOL, BTN_EDIT, BTN_DELETE } from "@/lib/form-fields.ts";
import { currentMonthStr } from "@/lib/date.ts";
const userId = Astro.locals.userId;
const rpRepo = new RecurringPaymentRepository();
const items = await rpRepo.findAll(userId);
const paramMonth = Astro.url.searchParams.get("month");
const selectedMonth = paramMonth && /^\d{4}-\d{2}$/.test(paramMonth) ? paramMonth : currentMonthStr();
const monthlyItems = await new RecurringPaymentMonthlyRepository().findByMonth(selectedMonth, userId);
const today = currentMonthStr();
const [curY, curM] = today.split("-").map(Number);
const nextMY = curM === 12 ? curY + 1 : curY;
const nextMM = curM === 12 ? 1 : curM + 1;
const nextMonth = `${nextMY}-${String(nextMM).padStart(2, "0")}`;
const startMonth = Astro.locals.createdAt
  ? (() => { const d = new Date(Astro.locals.createdAt!); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`; })()
  : today;
const twelveMonthsAgo = (() => {
  const total = curY * 12 + curM - 13;
  const y = Math.floor(total / 12);
  const m = total % 12 + 1;
  return `${y}-${String(m).padStart(2, "0")}`;
})();
const fromMonth = startMonth > twelveMonthsAgo ? startMonth : twelveMonthsAgo;
const recurringHistory = await rpRepo.getHistory(userId, fromMonth, nextMonth);
const paramTab = Astro.url.searchParams.get("tab");
const activeTab = paramTab === "list" ? "list" : paramTab === "history" ? "history" : "monthly";
const tabBtnClass = (t: string) =>
  `tab-btn px-4 py-2 text-sm font-medium border-b-2 -mb-px transition cursor-pointer ${
    activeTab === t ? "text-primary border-primary" : "text-string-muted hover:text-string border-transparent"
  }`;
const catRepo = new CategoryRepository();
const svcCategories = await catRepo.findBySections(userId, ["pagos-recurrentes"]);
const allRecurringCategories = svcCategories;
const pmRepo = new PaymentMethodRepository();
const paymentMethods = await pmRepo.findAll(userId);
const pmMap = Object.fromEntries(paymentMethods.map(pm => [pm.id, pm]));
const catMap = Object.fromEntries(allRecurringCategories.map(c => [c.id, c]));
const currencySymbol = CURRENCY_SYMBOL;
const fields = [
  FIELD_TYPE,
  { name: "name", label: "Descripción", type: "text" as const, required: true },
  { name: "default_amount", label: "Monto", type: "number" as const, required: true, step: "0.01" },
  FIELD_TYPE_CURRENCY,
  paymentMethodField(paymentMethods),
  categoryField(allRecurringCategories),
];
const defaultForm = { name: "", default_amount: 0, currency: "MXN", type: "expense", payment_method_id: paymentMethods[0]?.id ?? "", category_id: "" };
---

<AppLayout title="Pagos Recurrentes - Open PRP">
  <div data-module="recurring-payments" class="space-y-4">
    <PageHeader title="Pagos Recurrentes" />
    <div class="tabs-container">
      <div class="flex gap-0 border-b border-border" role="tablist" aria-label="Secciones de pagos recurrentes">
        <button data-tab="monthly" role="tab" id="tab-rp-monthly" aria-selected={activeTab === "monthly"} aria-controls="panel-rp-monthly" tabindex={activeTab === "monthly" ? 0 : -1} class={tabBtnClass("monthly")}>Movimientos del mes</button>
        <button data-tab="list" role="tab" id="tab-rp-list" aria-selected={activeTab === "list"} aria-controls="panel-rp-list" tabindex={activeTab === "list" ? 0 : -1} class={tabBtnClass("list")}>Administrar pagos</button>
        <button data-tab="history" role="tab" id="tab-rp-history" aria-selected={activeTab === "history"} aria-controls="panel-rp-history" tabindex={activeTab === "history" ? 0 : -1} class={tabBtnClass("history")}>Historial</button>
      </div>
      <div data-tab-content="monthly" role="tabpanel" id="panel-rp-monthly" aria-labelledby="tab-rp-monthly" tabindex="0" class:list={["tab-content pt-4", { hidden: activeTab !== "monthly" }]}>
        <RecurringPaymentsMonthly
          client:load
          createdAt={Astro.locals.createdAt}
          initialMonth={selectedMonth}
          initialPayments={JSON.stringify(items)}
          initialMonthly={JSON.stringify(monthlyItems)}
        />
      </div>
      <div data-tab-content="list" role="tabpanel" id="panel-rp-list" aria-labelledby="tab-rp-list" tabindex="0" class:list={["tab-content pt-4", { hidden: activeTab !== "list" }]}>
        <div class="flex items-center justify-between mb-4">
          <p class="text-sm text-string-muted">Todos tus pagos recurrentes registrados</p>
          <button data-create="recurring-payments" class="px-3 py-1.5 text-sm font-medium rounded-lg bg-primary text-white hover:bg-primary-hover cursor-pointer">Nuevo pago recurrente</button>
        </div>
        <DataTable columns={["Descripción", { label: "Monto", align: "right" }, "Tipo", "Moneda", "Método", "Categoría", { label: "Acciones", align: "right" }]} emptyMessage="Sin pagos recurrentes">
          {items.map(s => (
            <tr class="hover:bg-nav-hover">
              <td class="px-4 py-3 font-medium">{s.name}</td>
              <td class={`px-4 py-3 text-right font-mono ${s.type === "income" ? "text-success" : "text-danger"}`}>{s.type === "income" ? "+" : "-"}{currencySymbol[s.currency] || "$"}{Number(s.default_amount).toFixed(2)}</td>
              <td class="px-4 py-3"><span class={`text-xs px-2 py-0.5 rounded font-medium ${s.type === "income" ? "bg-success-bg text-success-text" : "bg-danger-bg text-danger-text"}`}>{s.type === "income" ? "Ingreso" : "Gasto"}</span></td>
              <td class="px-4 py-3 text-xs text-string-muted">{currencySymbol[s.currency] || "$"} {s.currency || "MXN"}</td>
              <td class="px-4 py-3"><span class="text-xs bg-surface-alt px-2 py-0.5 rounded">{pmMap[s.payment_method_id] ? `${pmMap[s.payment_method_id].icon || "💳"} ${pmMap[s.payment_method_id].name}` : "-"}</span></td>
              <td class="px-4 py-3">{s.category_id ? <span class="text-xs bg-surface-alt px-2 py-0.5 rounded">{catMap[s.category_id] ? `${catMap[s.category_id].icon || "📂"} ${catMap[s.category_id].name}` : "-"}</span> : "-"}</td>
              <td class="px-4 py-3 text-right space-x-2">
                <button data-edit-recurring-payments={s.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">{BTN_EDIT}</button>
                <button data-delete-recurring-payments={s.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">{BTN_DELETE}</button>
              </td>
            </tr>
          ))}
        </DataTable>
      </div>
      <div data-tab-content="history" role="tabpanel" id="panel-rp-history" aria-labelledby="tab-rp-history" tabindex="0" class:list={["tab-content pt-4", { hidden: activeTab !== "history" }]}>
        <RecurringPaymentsHistory
          client:load
          initialData={JSON.stringify(recurringHistory)}
          categories={JSON.stringify(catMap)}
          createdAt={Astro.locals.createdAt}
        />
      </div>
    </div>
  </div>
  <CrudModal client:load module="recurring-payments" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="pago recurrente" />
  <DeleteHandler module="recurring-payments" label="pago recurrente" />
</AppLayout>

<script>
  import { initTabs } from "@/lib/ui/tabs.ts";

  const container = document.querySelector<HTMLElement>(".tabs-container");
  if (container) {
    // Resolve initial tab: ?tab= param, legacy #hash, or default.
    const isTab = (v: string | null): v is "monthly" | "list" | "history" => v === "monthly" || v === "list" || v === "history";
    const paramTab = new URLSearchParams(location.search).get("tab");
    const hashTab = location.hash.replace("#", "");
    const initialTab = isTab(paramTab) ? paramTab : isTab(hashTab) ? hashTab : "monthly";
    initTabs(container, { initialTab, defaultTab: "monthly" });
  }
</script>
