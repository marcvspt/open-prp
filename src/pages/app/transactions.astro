---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import TransactionsFilterable from "@/components/app/transactions/TransactionsFilterable.tsx";
import { TransactionRepository } from "@/lib/modules/transactions/repository.ts";
import { PaymentMethodRepository } from "@/lib/modules/payment-methods/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { FIELD_TYPE_CURRENCY, FIELD_TYPE, paymentMethodField, categoryField, dateField } from "@/lib/form-fields.ts";
import { displayCategoryName } from "@/lib/category-labels.ts";
const userId = Astro.locals.userId;
const params = Astro.url.searchParams;
const filterType = params.get("type") || "all";
const filterMonth = params.get("month") || "";
const filterQ = params.get("q") || "";
const filterPm = params.get("payment_method_id") || "";
const filterCat = params.get("category_id") || "";
const pmRepo = new PaymentMethodRepository();
const paymentMethods = await pmRepo.findAll(userId);
const catRepo = new CategoryRepository();
const txCategories = await catRepo.findBySections(userId, ["transactions"]);
const repo = new TransactionRepository();
const txFilter: Record<string, unknown> = {};
if (filterType !== "all") txFilter.type = filterType;
if (filterMonth) txFilter.month = filterMonth;
if (filterQ) txFilter.q = filterQ;
if (filterPm) txFilter.payment_method_id = filterPm;
if (filterCat) txFilter.category_id = filterCat;
const initialData = await repo.findAll(userId, txFilter);
const fields = [
  dateField(),
  FIELD_TYPE,
  { name: "description", label: "Descripción", type: "text" as const },
  { name: "amount", label: "Monto", type: "number" as const, required: true, step: "0.01" },
  FIELD_TYPE_CURRENCY,
  paymentMethodField(paymentMethods),
  categoryField(txCategories),
];
const defaultForm = { type: "expense", description: "", amount: 0, currency: "MXN", payment_method_id: paymentMethods[0]?.id ?? "", category_id: "", date: "" };
---

<AppLayout title="Transacciones - Open PRP">
  <div data-module="transactions" class="space-y-4">
    <PageHeader title="Transacciones" createLabel="Nueva transacción" createModule="transactions" mobileOnlyCTA={true} />
    <TransactionsFilterable
      client:load
      initialMonth={filterMonth}
      createdAt={Astro.locals.createdAt}
      filterType={filterType}
      paymentMethods={paymentMethods.map(pm => ({ id: pm.id, icon: pm.icon, name: pm.name }))}
      categories={txCategories.map(c => ({ id: c.id, icon: c.icon, name: displayCategoryName(c) }))}
      initialData={JSON.stringify(initialData)}
    />
  </div>
  <CrudModal client:load module="transactions" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="transacción" />
  <DeleteHandler module="transactions" label="transacción" />
</AppLayout>