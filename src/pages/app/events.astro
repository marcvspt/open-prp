---
import { BTN_EDIT, BTN_DELETE } from "@/lib/general-fields.ts";
import { formatDate } from "@/lib/date.ts";
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { EventRepository } from "@/lib/modules/events/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { displayCategoryName } from "@/lib/category-labels.ts";
import { labels } from "@/lib/labels.ts";
const userId = Astro.locals.userId;
const items = (await new EventRepository().findAll(userId)).data ?? [];
const catRepo = new CategoryRepository();
const evCategories = await catRepo.findBySections(userId, ["events"]);
const catMap = Object.fromEntries(evCategories.map(c => [c.id, c]));
const statusLabels: Record<string, string> = { pending: labels.badge.pendingEvent, confirmed: labels.badge.confirmed, completed: labels.badge.completed, cancelled: labels.badge.cancelled };
const statusColor: Record<string, string> = { pending: "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300", confirmed: "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300", completed: "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300", cancelled: "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300" };
const fields = [
  { name: "description", label: labels.field.description, type: "textarea" as const, required: true },
  { name: "category_id", label: labels.field.category, type: "select" as const, options: [{ value: "", label: labels.field.noCategory }, ...evCategories.map(c => ({ value: c.id, label: `${c.icon || "📁"} ${displayCategoryName(c)}` }))] },
  { name: "location", label: labels.field.location, type: "text" as const },
  { name: "start_date", label: labels.field.start, type: "date" as const, required: true },
  { name: "end_date", label: labels.field.end, type: "date" as const },
  { name: "status", label: labels.field.status, type: "select" as const, options: [{ value: "pending", label: labels.badge.pendingEvent }, { value: "confirmed", label: labels.badge.confirmed }, { value: "completed", label: labels.badge.completed }, { value: "cancelled", label: labels.badge.cancelled }] },
  { name: "is_all_day", label: labels.field.allDay, type: "checkbox" as const },
];
const defaultForm = { description: "", category_id: "", location: "", start_date: "", end_date: "", status: "pending", is_all_day: false };
---

<AppLayout title={`${labels.page.events} - Open PRP`}>
  <div data-module="events" class="space-y-4">
    <PageHeader title={labels.page.events} createLabel={labels.cta.newEvent} createModule="events" />
    {items.length === 0 ? (
      <div class="text-string-muted text-sm">{labels.empty.events}</div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {items.map(ev => {
          const cat = ev.category_id && catMap[ev.category_id];
          return (
            <div class={`relative rounded-xl border p-4 transition-all hover:shadow-sm ${
              ev.status === "cancelled" ? "border-red-200 dark:border-red-700 bg-red-50/30 dark:bg-red-900/20 opacity-60" :
              ev.status === "completed" ? "border-green-200 dark:border-green-700 bg-green-50/30 dark:bg-green-900/20" :
              ev.status === "confirmed" ? "border-blue-200 dark:border-blue-700 bg-blue-50/30 dark:bg-blue-900/20" :
              "border-border bg-panel"
            }`}>
              <div class="flex items-start justify-between gap-2 mb-2">
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-string leading-snug">{ev.description}</div>
                </div>
                <span class={`shrink-0 text-xs px-2 py-0.5 rounded font-medium ${statusColor[ev.status]}`}>{statusLabels[ev.status]}</span>
              </div>
              <div class="flex items-center gap-3 text-xs text-string-muted mb-2">
                <span class="font-semibold">📅 {formatDate(ev.start_date)}</span>
                {ev.end_date && <span class="font-semibold">→ {formatDate(ev.end_date)}</span>}
                {ev.is_all_day && <span>🌙</span>}
              </div>
              <div class="flex items-center gap-2 text-xs text-string-muted">
                {cat && <span>{cat.icon || "📁"} {displayCategoryName(cat)}</span>}
                {ev.location && <span>📍 {ev.location}</span>}
              </div>
              <div class="flex justify-end gap-2 mt-3 pt-2 border-t border-border">
                <button data-edit-events={ev.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">{BTN_EDIT}</button>
                <button data-delete-events={ev.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">{BTN_DELETE}</button>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
  <CrudModal client:load module="events" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular={labels.singular.event} />
  <DeleteHandler module="events" label={labels.singular.event} />
</AppLayout>
