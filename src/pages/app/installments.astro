---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import TabBar from "@/components/app/ui/TabBar.tsx";
import InstallmentsFilterable from "@/components/app/installments/InstallmentsFilterable.tsx";
import InstallmentsSummary from "@/components/app/installments/InstallmentsSummary.tsx";
import { InstallmentRepository } from "@/lib/modules/installments/repository.ts";
import { CardRepository } from "@/lib/modules/cards/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { PaymentMethodRepository } from "@/lib/modules/payment-methods/repository.ts";
import { FIELD_TYPE_CURRENCY, paymentMethodField, categoryField, dateField } from "@/lib/form-fields.ts";
import { currentMonthStr } from "@/lib/date.ts";
const userId = Astro.locals.userId;
const currentMonth = currentMonthStr();
const params = Astro.url.searchParams;
const activeOnly = params.get("active_only") !== "false";
const filterMonth = params.get("month") || "";
const filterQ = params.get("q") || "";
const filterPm = params.get("payment_method_id") || "";
const filterCat = params.get("category_id") || "";
const initialTab = params.get("tab") === "admin" ? "admin" : "summary";
const catRepo = new CategoryRepository();
const instCategories = await catRepo.findBySections(userId, ["plazos"]);
const pmRepo = new PaymentMethodRepository();
const paymentMethods = await pmRepo.findAll(userId);
const instFilter: Record<string, unknown> = { active_only: activeOnly };
if (filterMonth) instFilter.month = filterMonth;
if (filterQ) instFilter.q = filterQ;
if (filterPm) instFilter.payment_method_id = filterPm;
if (filterCat) instFilter.category_id = filterCat;
const initialData = await new InstallmentRepository().findAll(userId, instFilter);
const allCards = await new CardRepository().findAll(userId);
const fields = [
  dateField("start_date"),
  { name: "description", label: "Descripción", type: "text" as const, required: true },
  { name: "total_amount", label: "Monto total", type: "number" as const, required: true, step: "0.01" },
  { name: "monthly_amount", label: "Cuota mensual", type: "number" as const, required: true, step: "0.01" },
  { name: "total_months", label: "Total de meses", type: "number" as const, required: true, min: 1 },
  FIELD_TYPE_CURRENCY,
  paymentMethodField(paymentMethods),
  categoryField(instCategories),
];
const defaultForm = { start_date: "", description: "", total_amount: 0, monthly_amount: 0, currency: "MXN", total_months: 1, payment_method_id: paymentMethods[0]?.id ?? "", category_id: "" };
---

<AppLayout title="Plazos - Open PRP">
  <div data-module="installments" class="space-y-4">
    <PageHeader title="Plazos / Cuotas" createLabel="Nuevo plazo" createModule="installments" mobileOnlyCTA={true} />
    <div class="tabs-container">
      <TabBar
        client:load
        tabs={[{ key: "summary", label: "Resumen" }, { key: "admin", label: "Administrar plazos" }]}
        initialTab={initialTab}
        defaultTab="summary"
        ariaLabel="Secciones de plazos"
      />
      <div data-tab-content="summary" role="tabpanel" id="panel-summary" aria-labelledby="tab-summary" tabindex="0" class:list={["tab-content pt-4", { hidden: initialTab !== "summary" }]}>
        <InstallmentsSummary
          client:load
          initialData={JSON.stringify(initialData)}
          initialCards={JSON.stringify(allCards)}
          initialPaymentMethods={JSON.stringify(paymentMethods)}
        />
      </div>
      <div data-tab-content="admin" role="tabpanel" id="panel-admin" aria-labelledby="tab-admin" tabindex="0" class:list={["tab-content pt-4", { hidden: initialTab !== "admin" }]}>
        <InstallmentsFilterable
          client:load
          initialMonth={filterMonth}
          createdAt={Astro.locals.createdAt}
          activeOnly={activeOnly}
          paymentMethods={paymentMethods.map(pm => ({ id: pm.id, icon: pm.icon, name: pm.name }))}
          categories={instCategories.map(c => ({ id: c.id, icon: c.icon, name: c.name }))}
          initialData={JSON.stringify(initialData)}
        />
      </div>
    </div>
  </div>
  <CrudModal client:load module="installments" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="plazo" />
  <DeleteHandler module="installments" label="plazo" />
</AppLayout>

