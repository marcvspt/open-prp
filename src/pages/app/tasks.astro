---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import ToggleHandler from "@/components/app/ui/ToggleHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { TaskRepository } from "@/lib/modules/tasks/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
const userId = Astro.locals.userId;
const filter = Astro.url.searchParams.get("filter") || "all";
const q: Record<string, unknown> = {};
if (filter === "pending") q.is_completed = false;
if (filter === "done") q.is_completed = true;
const items = await new TaskRepository().findAll(userId, q);
const categories = await new CategoryRepository().findBySections(userId, ["tareas"]);
const catMap = Object.fromEntries(categories.map(c => [c.id, c]));
const catOptions = [{ value: "", label: "Sin categoría" }, ...categories.map(c => ({ value: c.id, label: `${c.icon || "📋"} ${c.name}` }))];
const priorityLabels: Record<number, string> = { 1: "🟢 Baja", 2: "🟡 Media", 3: "🔴 Alta" };
const priorityColor: Record<number, string> = { 1: "bg-success-bg text-success-text", 2: "bg-warning-bg text-warning-text", 3: "bg-danger-bg text-danger-text" };
const fields = [
  { name: "description", label: "Descripción", type: "textarea" as const, required: true },
  { name: "due_date", label: "Fecha de vencimiento", type: "date" as const },
  { name: "priority", label: "Prioridad", type: "select" as const, options: [{ value: "1", label: "🟢 1 - Baja" }, { value: "2", label: "🟡 2 - Media" }, { value: "3", label: "🔴 3 - Alta" }] },
  { name: "category", label: "Categoría", type: "select" as const, options: catOptions },
];
const defaultForm = { description: "", due_date: "", priority: 1, category: "" };
---

<AppLayout title="Tareas - Open PRP">
  <div data-module="tasks" class="space-y-4">
    <PageHeader title="Tareas" createLabel="Nueva tarea" createModule="tasks" />
    <div class="flex gap-2 flex-wrap">
      {[["all", "Todas"], ["pending", "Pendientes"], ["done", "Completadas"]].map(([v, l]) => (
        <a href={v === "all" ? "/tasks" : `/tasks?filter=${v}`}
           class={`px-3 py-1.5 text-sm rounded-lg ${filter === v ? "bg-primary-bg text-primary-text font-medium" : "bg-surface-alt text-nav hover:bg-nav-hover"}`}>{l}</a>
      ))}
    </div>
    {items.length === 0 ? (
      <div class="text-string-muted text-sm">Sin tareas</div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {items.map(t => {
          const cat = t.category && catMap[t.category];
          return (
            <div class={`relative rounded-xl border p-4 transition-all hover:shadow-sm ${
              t.is_completed ? "border-success-border bg-success-border/10 opacity-60" :
              "border-border bg-panel"
            }`}>
              <div class="flex items-start gap-3 mb-2">
                <input type="checkbox" checked={t.is_completed} data-toggle-tasks={t.id} class="mt-0.5 w-4 h-4 accent-primary cursor-pointer shrink-0" />
                <div class="flex-1 min-w-0">
                  <div class={`text-sm leading-snug ${t.is_completed ? "line-through text-string-muted" : "font-medium text-string"}`}>
                    {t.description}
                  </div>
                </div>
                <span class={`shrink-0 text-xs px-2 py-0.5 rounded font-medium ${priorityColor[t.priority] || "bg-surface-alt text-string-muted"}`}>
                  {priorityLabels[t.priority] || "⚪"}
                </span>
              </div>
              <div class="flex items-center gap-3 text-xs text-string-muted ml-7">
                {cat && <span>{cat.icon || "📋"} {cat.name}</span>}
                {t.due_date && (
                  <span class="font-semibold">📅 {new Date(t.due_date).toLocaleDateString("es")}</span>
                )}
              </div>
              <div class="flex justify-end gap-2 mt-3 pt-2 border-t border-border ml-7">
                <button data-edit-tasks={t.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">Editar</button>
                <button data-delete-tasks={t.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">Eliminar</button>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
  <CrudModal client:load module="tasks" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="tarea" />
  <DeleteHandler module="tasks" label="tarea" />
  <ToggleHandler module="tasks" key="is_completed" />
</AppLayout>
