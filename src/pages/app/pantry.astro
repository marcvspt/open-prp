---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DataTable from "@/components/app/ui/DataTable.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { PantryRepository } from "@/lib/modules/pantry/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
const userId = Astro.locals.userId;
const items = await new PantryRepository().findAll(userId);
const categories = await new CategoryRepository().findBySections(userId, ["despensa"]);
const catMap = Object.fromEntries(categories.map(c => [c.id, c]));
const catOptions = [{ value: "", label: "Sin categoría" }, ...categories.map(c => ({ value: c.id, label: `${c.icon || "📦"} ${c.name}` }))];
const fields = [
  { name: "description", label: "Artículo", type: "text" as const, required: true },
  { name: "category_id", label: "Categoría", type: "select" as const, options: catOptions },
  { name: "default_quantity", label: "Cantidad por defecto", type: "number" as const, min: 0, step: "0.01" },
  { name: "notes", label: "Notas", type: "textarea" as const },
];
const defaultForm = { description: "", category_id: "", default_quantity: 1, notes: "" };
---

<AppLayout title="Despensa - Open PRP">
  <div data-module="pantry" class="space-y-4">
    <PageHeader title="Despensa" createLabel="Nuevo producto" createModule="pantry" />
    <DataTable columns={["Artículo", "Cant.", "Categoría", "Notas", { label: "Acciones", align: "right" }]} emptyMessage="Sin productos en la despensa">
      {items.map(i => (
        <tr class="hover:bg-nav-hover">
          <td class="px-4 py-3 font-medium">{i.description}</td>
          <td class="px-4 py-3">{i.default_quantity}</td>
          <td class="px-4 py-3">{i.category_id ? (catMap[i.category_id] ? <span class="text-xs bg-surface-alt px-2 py-0.5 rounded">{catMap[i.category_id].icon || "📦"} {catMap[i.category_id].name}</span> : "-") : "-"}</td>
          <td class="px-4 py-3 text-string-muted text-sm">{i.notes || "-"}</td>
          <td class="px-4 py-3 text-right space-x-2">
            <button data-edit-pantry={i.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">Editar</button>
            <button data-delete-pantry={i.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">Eliminar</button>
          </td>
        </tr>
      ))}
    </DataTable>
  </div>
  <CrudModal client:load module="pantry" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="producto" />
  <DeleteHandler module="pantry" label="producto" />
</AppLayout>
