---
import { BTN_EDIT, BTN_DELETE } from "@/lib/general-fields.ts";
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DataTable from "@/components/app/ui/DataTable.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { displayCategoryName } from "@/lib/category-labels.ts";
const userId = Astro.locals.userId;
const items = await new CategoryRepository().findAll(userId);
const SECTION_LABELS: Record<string, string> = {
  pantry: "Despensa",
  tasks: "Tareas",
  transactions: "Transacciones",
  installments: "Plazos",
  events: "Eventos",
  "recurring-payments": "Pagos recurrentes",
};
const SECTION_COLORS: Record<string, string> = {
  pantry: "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300",
  tasks: "bg-sky-100 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300",
  transactions: "bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300",
  installments: "bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300",
  events: "bg-rose-100 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300",
  "recurring-payments": "bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300",
};
const TYPE_LABELS: Record<string, string> = {
  global: "Global",
  personal: "Personal",
};
const TYPE_COLORS: Record<string, string> = {
  global: "bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300",
  personal: "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300",
};
const sectionOptions = Object.entries(SECTION_LABELS).map(([value, label]) => ({ value, label }));
const fields = [
  { name: "name", label: "Nombre", type: "text" as const, required: true },
  { name: "sections", label: "Secciones", type: "multiselect" as const, options: sectionOptions, placeholder: "Seleccionar secciones..." },
  { name: "icon", label: "Ícono (emoji)", type: "text" as const, placeholder: "🛒" },
  { name: "color", label: "Color", type: "color" as const },
];
const defaultForm = { name: "", type: "personal", sections: JSON.stringify(["transactions"]), icon: "📁", color: "#6366f1" };
---

<AppLayout title="Categorías - Open PRP">
  <div data-module="categories" class="space-y-4">
    <PageHeader title="Categorías" createLabel="Nueva categoría" createModule="categories" />
    <DataTable columns={["Nombre", "Tipo", "Secciones", { label: "Icono", align: "center" }, "Color", { label: "Acciones", align: "right" }]} emptyMessage="Sin categorías">
      {items.map(c => {
        let sections: string[] = [];
        try { sections = JSON.parse(c.sections); } catch {}
        if (!Array.isArray(sections)) sections = [];
        const isSystem = c.type === "global";
        return (
        <tr class="hover:bg-nav-hover">
          <td class="px-4 py-3">{displayCategoryName(c)}</td>
          <td class="px-4 py-3"><span class={`text-xs font-medium px-2 py-0.5 rounded ${TYPE_COLORS[c.type] || "bg-surface-alt text-string-muted"}`}>{TYPE_LABELS[c.type] || c.type}</span></td>
          <td class="px-4 py-3"><div class="flex gap-1 flex-wrap">{sections.length > 0 ? sections.map(s => <span class={`text-xs font-medium px-2 py-0.5 rounded ${SECTION_COLORS[s] || "bg-surface-alt text-string-muted"}`}>{SECTION_LABELS[s] || s}</span>) : <span class="text-xs text-string-muted">-</span>}</div></td>
          <td class="px-4 py-3 text-center">{c.icon || "-"}</td>
          <td class="px-4 py-3"><span class="inline-block w-5 h-5 rounded-full border border-border" style={{ backgroundColor: c.color || "#6366f1" }} /></td>
          <td class="px-4 py-3 text-right space-x-2">
            {!isSystem && <>
              <button data-edit-categories={c.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">{BTN_EDIT}</button>
              <button data-delete-categories={c.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">{BTN_DELETE}</button>
            </>}
          </td>
        </tr>
      );})}
    </DataTable>
  </div>
  <CrudModal client:load module="categories" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="categoría" />
  <DeleteHandler module="categories" label="categoría" />
</AppLayout>
