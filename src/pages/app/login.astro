---
import BaseLayout from "@/layouts/BaseLayout.astro";

import { SignInButton, SignUpButton } from "@clerk/astro/components";
import ThemeToggle from "@/components/ui/ThemeToggle.tsx";

const { userId } = Astro.locals.auth();
if (userId) return Astro.redirect("/app/dashboard");
---

<BaseLayout title="Iniciar sesión | Open PRP">
  <div class="flex items-center justify-center min-h-screen bg-surface">
    <div class="text-center space-y-4">
      <h1 class="text-2xl font-bold text-primary">Open PRP</h1>
      <p class="text-string-muted">Personal Resource Planning</p>
      <div class="flex justify-center gap-2">
        <SignInButton
          mode="modal"
          redirectUrl="/app/dashboard"
          class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover"
        >
          Iniciar sesión
        </SignInButton>
        <SignUpButton
          mode="modal"
          redirectUrl="/app/dashboard"
          class="px-4 py-2 border border-border rounded-lg hover:bg-nav-hover text-string"
        >
          Registrarse
        </SignUpButton>
      </div>
      <div class="flex justify-center pt-4">
        <ThemeToggle client:load />
      </div>
      <div class="pt-6">
        <a
          href="/"
          class="text-sm text-string-muted hover:text-primary transition-colors"
          >← Volver al inicio</a
        >
      </div>
    </div>
  </div>
</BaseLayout>
