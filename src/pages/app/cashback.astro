---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DataTable from "@/components/app/ui/DataTable.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { CashbackRepository } from "@/lib/modules/cashback/repository.ts";
import { CreditCardRepository } from "@/lib/modules/credit-cards/repository.ts";
const userId = Astro.locals.userId;
const items = await new CashbackRepository().findAll(userId);
const allCards = await new CreditCardRepository().findAll(userId);
const creditCards = allCards.filter(c => c.type === "credit");
const cardMap = Object.fromEntries(allCards.map(c => [c.id, c]));
const cardEmoji = (type: string) => type === "credit" ? "💳" : type === "debit" ? "🏦" : "🎫";
const currencySymbol: Record<string, string> = { EUR: "€", MXN: "$", USD: "$" };
const fields = [
  { name: "date", label: "Fecha", type: "date" as const, required: true },
  { name: "description", label: "Descripción", type: "text" as const },
  { name: "amount", label: "Monto", type: "number" as const, required: true, step: "0.01" },
  { name: "currency", label: "Moneda", type: "select" as const, options: [{ value: "EUR", label: "€ EUR" }, { value: "MXN", label: "$ MXN" }, { value: "USD", label: "$ USD" }] },
  { name: "card_id", label: "Tarjeta", type: "select" as const, options: [{ value: "", label: "Sin tarjeta" }, ...creditCards.map(c => ({ value: c.id, label: `${cardEmoji(c.type)} ${c.name}` }))] },
];
const defaultForm = { date: "", description: "", amount: 0, currency: "MXN", card_id: "" };
---

<AppLayout title="Cashback - Open PRP">
  <div data-module="cashback" class="space-y-4">
    <PageHeader title="Cashback" createLabel="Nuevo cashback" createModule="cashback" />
    <DataTable columns={["Fecha", "Descripción", { label: "Monto", align: "right" }, "Moneda", "Tarjeta", { label: "Acciones", align: "right" }]} emptyMessage="Sin cashback">
      {items.map(c => (
        <tr key={c.id} class="hover:bg-nav-hover">
          <td class="px-4 py-3 font-semibold">{new Date(c.date).toLocaleDateString("es")}</td>
          <td class="px-4 py-3">{c.description || "-"}</td>
          <td class="px-4 py-3 text-right font-mono text-success">+{currencySymbol[c.currency] || "$"}{Number(c.amount).toFixed(2)}</td>
          <td class="px-4 py-3 text-xs text-string-muted">{currencySymbol[c.currency] || "$"} {c.currency || "MXN"}</td>
          <td class="px-4 py-3">{c.card_id ? (cardMap[c.card_id] ? <span class="inline-flex items-center gap-1 text-xs bg-surface-alt px-2 py-0.5 rounded">{cardEmoji(cardMap[c.card_id].type)} {cardMap[c.card_id].name}</span> : "-") : "-"}</td>
          <td class="px-4 py-3 text-right space-x-2">
            <button data-edit-cashback={c.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">Editar</button>
            <button data-delete-cashback={c.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">Eliminar</button>
          </td>
        </tr>
      ))}
    </DataTable>
  </div>
  <CrudModal client:load module="cashback" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="cashback" />
  <DeleteHandler module="cashback" label="cashback" />
</AppLayout>
