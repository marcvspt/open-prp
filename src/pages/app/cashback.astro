---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import CashbackFilterable from "@/components/app/cashback/CashbackFilterable.tsx";
import { CardRepository } from "@/lib/modules/cards/repository.ts";
import { FIELD_TYPE_CURRENCY, cardField, dateField } from "@/lib/form-fields.ts";
import { getMonthOptions } from "@/lib/date.ts";
import { CashbackRepository } from "@/lib/modules/cashback/repository.ts";
const userId = Astro.locals.userId;
const params = Astro.url.searchParams;
const filterMonth = params.get("month") || "";
const filterQ = params.get("q") || "";
const filterCard = params.get("card_id") || "";
const allCards = await new CardRepository().findAll(userId);
const creditCards = allCards.filter(c => c.type === "credit");
const months = getMonthOptions();
const cbFilter: Record<string, unknown> = {};
if (filterMonth) cbFilter.month = filterMonth;
if (filterQ) cbFilter.q = filterQ;
if (filterCard) cbFilter.card_id = filterCard;
const initialData = await new CashbackRepository().findAll(userId, cbFilter);
const fields = [
  dateField(),
  { name: "description", label: "Descripción", type: "text" as const },
  { name: "amount", label: "Monto", type: "number" as const, required: true, step: "0.01" },
  FIELD_TYPE_CURRENCY,
  cardField(creditCards),
];
const defaultForm = { date: "", description: "", amount: 0, currency: "MXN", card_id: creditCards[0]?.id ?? "" };
---

<AppLayout title="Cashback - Open PRP">
  <div data-module="cashback" class="space-y-4">
    <PageHeader title="Cashback" createLabel="Nuevo cashback" createModule="cashback" mobileOnlyCTA={true} />
    <CashbackFilterable
      client:load
      initialMonth={filterMonth || months[0]}
      cards={creditCards.map(c => ({ id: c.id, name: c.name, type: c.type }))}
      initialData={JSON.stringify(initialData)}
    />
  </div>
  <CrudModal client:load module="cashback" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="cashback" />
  <DeleteHandler module="cashback" label="cashback" />
</AppLayout>