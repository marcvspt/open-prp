---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import DataTable from "@/components/ui/DataTable.astro";
import DeleteHandler from "@/components/ui/DeleteHandler.astro";
import CrudModal from "@/components/ui/CrudModal";
import { ServiceRepository } from "@/lib/modules/services/repository";
const userId = Astro.locals.userId;
const items = await new ServiceRepository().findAll(userId);
const fields = [
  { name: "name", label: "Nombre", type: "text" as const, required: true },
  { name: "default_amount", label: "Monto por defecto", type: "number" as const, required: true, step: "0.01" },
  { name: "card_id", label: "ID de tarjeta (opcional)", type: "text" as const },
];
const defaultForm = { name: "", default_amount: 0, card_id: "" };
---

<BaseLayout title="Servicios - Open PHRP">
  <div data-module="services" class="space-y-4">
    <PageHeader title="Servicios recurrentes" createLabel="Nuevo servicio" createModule="services" />
    <DataTable columns={["Nombre", { label: "Monto", align: "right" }, { label: "Tarjeta", align: "center" }]} emptyMessage="Sin servicios">
      {items.map(s => (
        <tr key={s.id} class="hover:bg-nav-hover">
          <td class="px-4 py-3 font-medium">{s.name}</td>
          <td class="px-4 py-3 text-right font-mono">${Number(s.default_amount).toFixed(2)}</td>
          <td class="px-4 py-3 text-center">{s.card_id ? <span class="text-xs bg-gray-100 px-2 py-0.5 rounded">Vinculado</span> : "-"}</td>
          <td class="px-4 py-3 text-right space-x-2">
            <button data-edit-services={s.id} class="text-indigo-600 hover:text-indigo-800 text-xs font-medium cursor-pointer">Editar</button>
            <button data-delete-services={s.id} class="text-red-600 hover:text-red-800 text-xs font-medium cursor-pointer">Eliminar</button>
          </td>
        </tr>
      ))}
    </DataTable>
  </div>
  <CrudModal client:load module="services" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="servicio" />
  <DeleteHandler module="services" label="servicio" />
</BaseLayout>
