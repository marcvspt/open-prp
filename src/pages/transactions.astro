---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import DataTable from "@/components/ui/DataTable.astro";
import DeleteHandler from "@/components/ui/DeleteHandler.astro";
import CrudModal from "@/components/ui/CrudModal.tsx";
import { TransactionRepository } from "@/lib/modules/transactions/repository.ts";
import { PaymentMethodRepository } from "@/lib/modules/payment-methods/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
const userId = Astro.locals.userId;
const filterType = Astro.url.searchParams.get("type") || "all";
const repo = new TransactionRepository();
const result = await repo.findAll(userId, { page: 1, pageSize: 200, ...(filterType !== "all" ? { type: filterType as "income" | "expense" } : {}) });
const items = result ?? [];
const pmRepo = new PaymentMethodRepository();
const paymentMethods = await pmRepo.findAll(userId);
const catRepo = new CategoryRepository();
const txCategories = await catRepo.findBySections(userId, ["transacciones"]);
const currencySymbol: Record<string, string> = { EUR: "€", MXN: "$", USD: "$" };
const fields = [
  { name: "type", label: "Tipo", type: "select" as const, required: true, options: [{ value: "expense", label: "Gasto" }, { value: "income", label: "Ingreso" }] },
  { name: "description", label: "Descripción", type: "text" as const },
  { name: "amount", label: "Monto", type: "number" as const, required: true, step: "0.01" },
  { name: "currency", label: "Moneda", type: "select" as const, options: [{ value: "EUR", label: "€ EUR" }, { value: "MXN", label: "$ MXN" }, { value: "USD", label: "$ USD" }] },
  { name: "payment_method_id", label: "Método de pago", type: "select" as const, options: [{ value: "", label: "Sin método" }, ...paymentMethods.map(pm => ({ value: pm.id, label: `${pm.icon || "💳"} ${pm.name}` }))] },
  { name: "category_id", label: "Categoría", type: "select" as const, options: [{ value: "", label: "Sin categoría" }, ...txCategories.map(c => ({ value: c.id, label: `${c.icon || "📂"} ${c.name}` }))] },
  { name: "date", label: "Fecha", type: "date" as const, required: true },
];
const defaultForm = { type: "expense", description: "", amount: 0, currency: "MXN", payment_method_id: "", category_id: "", date: "" };
const pmMap = Object.fromEntries(paymentMethods.map(pm => [pm.id, pm]));
const catMap = Object.fromEntries(txCategories.map(c => [c.id, c]));
---

<BaseLayout title="Transacciones - Open PRP">
  <div data-module="transactions" class="space-y-4">
    <PageHeader title="Transacciones" createLabel="Nueva transacción" createModule="transactions" />
    <div class="flex gap-2">
      {[["all", "Todas"], ["income", "Ingresos"], ["expense", "Gastos"]].map(([v, l]) => (
        <a href={v === "all" ? "/transactions" : `/transactions?type=${v}`}
           class={`px-3 py-1.5 text-sm rounded-lg ${filterType === v ? "bg-indigo-100 text-indigo-700 font-medium" : "bg-surface-alt text-nav hover:bg-nav-hover"}`}>{l}</a>
      ))}
    </div>
    <DataTable columns={["Fecha", "Descripción", { label: "Monto", align: "right" }, "Moneda", "Método", "Tipo", "Categoría", { label: "Acciones", align: "right" }]} emptyMessage="Sin transacciones">
      {items.map(tx => (
        <tr key={tx.id} class="hover:bg-nav-hover">
          <td class="px-4 py-3 font-semibold">{new Date(tx.date).toLocaleDateString("es")}</td>
          <td class="px-4 py-3">{tx.description || "-"}</td>
          <td class={`px-4 py-3 text-right font-mono ${tx.type === "income" ? "text-green-600" : "text-red-600"}`}>{tx.currency === "EUR" ? "€" : "$"}{Number(tx.amount).toFixed(2)}</td>
          <td class="px-4 py-3 text-xs text-string-muted">{currencySymbol[tx.currency] || "$"} {tx.currency || "MXN"}</td>
          <td class="px-4 py-3 text-xs text-string-muted">{tx.payment_method_id ? (pmMap[tx.payment_method_id] ? `${pmMap[tx.payment_method_id].icon || "💳"} ${pmMap[tx.payment_method_id].name}` : "-") : "-"}</td>
          <td class="px-4 py-3"><span class={`text-xs font-medium px-2 py-0.5 rounded ${tx.type === "income" ? "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300" : "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300"}`}>{tx.type === "income" ? "Ingreso" : "Gasto"}</span></td>
          <td class="px-4 py-3">{tx.category_id ? <span class="text-xs bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded">{catMap[tx.category_id] ? `${catMap[tx.category_id].icon || "📂"} ${catMap[tx.category_id].name}` : "-"}</span> : "-"}</td>
          <td class="px-4 py-3 text-right space-x-2">
            <button data-edit-transactions={tx.id} class="text-indigo-600 hover:text-indigo-800 text-xs font-medium cursor-pointer">Editar</button>
            <button data-delete-transactions={tx.id} class="text-red-600 hover:text-red-800 text-xs font-medium cursor-pointer">Eliminar</button>
          </td>
        </tr>
      ))}
    </DataTable>
  </div>
  <CrudModal client:load module="transactions" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="transacción" />
  <DeleteHandler module="transactions" label="transacción" />
</BaseLayout>
