---
import AppLayout from "@/layouts/AppLayout.astro";
import NotesContent from "@/components/app/notes/NotesContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.notes}`}>
  <NotesContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>