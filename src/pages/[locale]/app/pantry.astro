---
import AppLayout from "@/layouts/AppLayout.astro";
import PantryContent from "@/components/app/pantry/PantryContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.pantry}`}>
  <PantryContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>