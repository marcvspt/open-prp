---
import AppLayout from "@/layouts/AppLayout.astro";
import CardsContent from "@/components/app/cards/CardsContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.cards}`}>
  <CardsContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>