---
import AppLayout from "@/layouts/AppLayout.astro";
import TransactionsContent from "@/components/app/transactions/TransactionsContent.astro";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.transactions}`}>
  <TransactionsContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>