---
import AppLayout from "@/layouts/AppLayout.astro";
import RecurringPaymentsContent from "@/components/app/recurring-payments/RecurringPaymentsContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.recurringPayments}`}>
  <RecurringPaymentsContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>