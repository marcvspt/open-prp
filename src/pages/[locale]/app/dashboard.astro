---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardPanels from "@/components/app/dashboard/DashboardPanels.astro";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import TabBarWithMonth from "@/components/app/ui/TabBarWithMonth.tsx";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";
import { currentMonthStr, isAvailableMonth } from "@/lib/date.ts";

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);

const { userId, createdAt } = Astro.locals;
const paramMonth = Astro.url.searchParams.get("month");
const selectedMonth = paramMonth && isAvailableMonth(paramMonth, createdAt) ? paramMonth : currentMonthStr();
const initialTab = Astro.url.searchParams.get("tab") === "analytics" ? "analytics" : "summary";
---

<AppLayout title={`${t.page.dashboard}`}>
  <div class="space-y-4">
    <PageHeader title={t.page.dashboard} />
    <div class="tabs-container">
      <TabBarWithMonth
        client:load
        tabs={[{ key: "summary", label: t.tabs.summary }, { key: "analytics", label: t.tabs.analytics }]}
        initialTab={initialTab}
        defaultTab="summary"
        ariaLabel={t.dashboard.ariaTabs}
        initialMonth={selectedMonth}
        createdAt={createdAt}
        omitCurrentMonth
        locale={locale}
      />
      <DashboardPanels userId={userId} month={selectedMonth} locale={locale} initialTab={initialTab} />
    </div>
  </div>
</AppLayout>

<script>
  import { refreshCurrentSection } from "@/lib/ui/data-refresh.ts";

  window.addEventListener("monthchange", () => {
    if (/\/app\/dashboard\/?$/.test(location.pathname)) void refreshCurrentSection("dashboard");
  });
</script>
