---
import AppLayout from "@/layouts/AppLayout.astro";
import DashboardHeader from "@/components/app/dashboard/DashboardHeader.tsx";
import DashboardContent from "@/components/app/dashboard/DashboardContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";
import { currentMonthStr } from "@/lib/date.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);

const paramMonth = Astro.url.searchParams.get("month");
const selectedMonth = paramMonth && /^\d{4}-\d{2}$/.test(paramMonth) ? paramMonth : currentMonthStr();
---

<AppLayout title={`${t.page.dashboard}`}>
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-string">{t.page.dashboard}</h1>
      <DashboardHeader client:load initialMonth={selectedMonth} createdAt={Astro.locals.createdAt} locale={locale} />
    </div>

    <DashboardContent userId={Astro.locals.userId} month={selectedMonth} locale={locale} />
  </div>
</AppLayout>
