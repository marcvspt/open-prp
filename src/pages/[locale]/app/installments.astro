---
import AppLayout from "@/layouts/AppLayout.astro";
import InstallmentsContent from "@/components/app/installments/InstallmentsContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.installments}`}>
  <InstallmentsContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>