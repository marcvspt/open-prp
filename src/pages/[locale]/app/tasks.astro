---
import AppLayout from "@/layouts/AppLayout.astro";
import TasksContent from "@/components/app/tasks/TasksContent.astro";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.tasks}`}>
  <TasksContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>