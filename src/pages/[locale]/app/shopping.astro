---
import AppLayout from "@/layouts/AppLayout.astro";
import ShoppingContent from "@/components/app/shopping/ShoppingContent.astro";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.shopping}`}>
  <ShoppingContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>