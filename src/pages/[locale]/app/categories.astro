---
import AppLayout from "@/layouts/AppLayout.astro";
import CategoriesContent from "@/components/app/categories/CategoriesContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.categories}`}>
  <CategoriesContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>