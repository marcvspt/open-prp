---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

import { SignInButton, SignUpButton } from "@clerk/astro/components";
import ThemeToggle from "@/components/ui/ThemeToggle.tsx";
import { BTN_LOGIN, BTN_SIGNUP } from "@/lib/i18n/general-fields.ts";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
const dashboardUrl = getRelativeLocaleUrl(locale, "/app/dashboard");
const homeUrl = getRelativeLocaleUrl(locale, "/");

const { userId } = Astro.locals.auth();
if (userId) return Astro.redirect(dashboardUrl);
---

<BaseLayout title={`${t.common.login}`}>
  <div class="flex items-center justify-center min-h-screen bg-surface">
    <div class="text-center space-y-4">
      <h1 class="text-2xl font-bold text-primary">Open PRP</h1>
      <p class="text-string-muted">Open Personal Resource Planning</p>
      <div class="flex justify-center gap-2">
        <SignInButton mode="modal" fallbackRedirectUrl={dashboardUrl} asChild>
          <button
            class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover cursor-pointer"
            >{BTN_LOGIN(t)}</button
          >
        </SignInButton>
        <SignUpButton mode="modal" fallbackRedirectUrl={dashboardUrl} asChild>
          <button
            class="px-4 py-2 border border-border rounded-lg hover:bg-nav-hover text-string cursor-pointer"
            >{BTN_SIGNUP(t)}</button
          >
        </SignUpButton>
      </div>
      <div class="flex items-center justify-center gap-3 pt-6">
        <a
          href={homeUrl}
          class="text-sm text-string-muted hover:text-primary transition-colors"
          >{t.common.backHome}</a
        >
        <div class="w-36"><ThemeToggle client:load locale={locale} /></div>
      </div>
    </div>
  </div>
</BaseLayout>
