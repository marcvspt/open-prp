---
import AppLayout from "@/layouts/AppLayout.astro";
import CashbackContent from "@/components/app/cashback/CashbackContent.astro";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.cashback}`}>
  <CashbackContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>