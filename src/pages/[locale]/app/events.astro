---
import AppLayout from "@/layouts/AppLayout.astro";
import EventsContent from "@/components/app/events/EventsContent.astro";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.events}`}>
  <EventsContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>