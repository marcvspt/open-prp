---
import AppLayout from "@/layouts/AppLayout.astro";
import PaymentMethodsContent from "@/components/app/payment-methods/PaymentMethodsContent.astro";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);
---

<AppLayout title={`${t.page.paymentMethods}`}>
  <PaymentMethodsContent userId={Astro.locals.userId} locale={locale} />
</AppLayout>