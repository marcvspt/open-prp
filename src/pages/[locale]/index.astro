---
import LandingLayout from "@/layouts/LandingLayout.astro";
import Hero from "@/components/landing/Hero.astro";
import FeatureCard from "@/components/landing/FeatureCard.astro";
import DollarIcon from "@/assets/dollar.svg";
import CardIcon from "@/assets/card.svg";
import ClipboardIcon from "@/assets/clipboard.svg";
import RecurringIcon from "@/assets/recurring.svg";
import PackageIcon from "@/assets/package.svg";
import CartIcon from "@/assets/cart.svg";
import { LOCALES } from "@/lib/i18n/locale.ts";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

export const prerender = true;

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);

const FEATURE_ICONS = [DollarIcon, CardIcon, ClipboardIcon, RecurringIcon, PackageIcon, CartIcon];
const FEATURES_INFO = t.landing.features.map((feature, i) => ({ icon: FEATURE_ICONS[i], ...feature }));
---

<LandingLayout title={`${t.page.home}`}>
  <Hero />
  <section id="features" class="border-t border-border bg-surface-alt py-24">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-center text-3xl font-bold text-string sm:text-4xl">{t.landing.featuresTitle}</h2>
      <p class="mt-4 text-center text-string-muted">{t.landing.featuresTagline}</p>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {FEATURES_INFO.map(({ icon: Icon, title, description }) => (
          <FeatureCard title={title} description={description}>
            <Icon class="h-6 w-6 text-primary" />
          </FeatureCard>
        ))}
      </div>
    </div>
  </section>
</LandingLayout>
