---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import DeleteHandler from "@/components/ui/DeleteHandler.astro";
import CrudModal from "@/components/ui/CrudModal";
import { FamilyRepository } from "@/lib/modules/families/repository";
const userId = Astro.locals.userId;
const families = await new FamilyRepository().findAllByUser(userId);
const roleColor: Record<string, string> = { admin: "bg-purple-100 text-purple-700", member: "bg-blue-100 text-blue-700", viewer: "bg-surface-alt text-nav" };
const fields = [{ name: "name", label: "Nombre", type: "text" as const, required: true }];
const defaultForm = { name: "" };
---

<BaseLayout title="Familias - Open PHRP">
  <div data-module="families" class="space-y-4">
    <PageHeader title="Familias" createLabel="Nueva familia" createModule="families" />
    {families.length === 0 ? (
      <p class="text-center text-text-muted py-8">Sin familias</p>
    ) : (
      <div class="space-y-3">
        {families.map(f => (
          <div key={f.id} class="bg-panel rounded-xl border border-border shadow-sm p-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="font-semibold text-text">{f.name}</h3>
                <p class="text-xs text-text-muted">Creada {new Date(f.created_at).toLocaleDateString("es")} · Tu rol: <span class={`text-xs px-2 py-0.5 rounded ${roleColor[f.role]}`}>{f.role}</span></p>
              </div>
              <div class="flex gap-2">
                <button data-edit-families={f.id} class="text-xs text-text-muted hover:text-indigo-600 cursor-pointer">✏️</button>
                <button data-delete-families={f.id} class="text-xs text-text-muted hover:text-red-600 cursor-pointer">🗑️</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
  <CrudModal client:load module="families" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="familia" />
  <DeleteHandler module="families" label="familia" />
</BaseLayout>
