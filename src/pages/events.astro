---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import DeleteHandler from "@/components/ui/DeleteHandler.astro";
import CrudModal from "@/components/ui/CrudModal.tsx";
import { EventRepository } from "@/lib/modules/events/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
const userId = Astro.locals.userId;
const items = (await new EventRepository().findAll(userId)).data ?? [];
const catRepo = new CategoryRepository();
const evCategories = await catRepo.findBySections(userId, ["eventos"]);
const catMap = Object.fromEntries(evCategories.map(c => [c.id, c]));
const statusLabels: Record<string, string> = { pending: "🟡 Pendiente", confirmed: "🔵 Confirmado", completed: "🟢 Completado", cancelled: "🔴 Cancelado" };
const statusColor: Record<string, string> = { pending: "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300", confirmed: "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300", completed: "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300", cancelled: "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300" };
const fields = [
  { name: "description", label: "Descripción", type: "textarea" as const, required: true },
  { name: "category_id", label: "Categoría", type: "select" as const, options: [{ value: "", label: "Sin categoría" }, ...evCategories.map(c => ({ value: c.id, label: `${c.icon || "📁"} ${c.name}` }))] },
  { name: "location", label: "Ubicación", type: "text" as const },
  { name: "start_date", label: "Inicio", type: "date" as const, required: true },
  { name: "end_date", label: "Fin", type: "date" as const },
  { name: "status", label: "Estado", type: "select" as const, options: [{ value: "pending", label: "🟡 Pendiente" }, { value: "confirmed", label: "🔵 Confirmado" }, { value: "completed", label: "🟢 Completado" }, { value: "cancelled", label: "🔴 Cancelado" }] },
  { name: "is_all_day", label: "Día completo", type: "checkbox" as const },
];
const defaultForm = { description: "", category_id: "", location: "", start_date: "", end_date: "", status: "pending", is_all_day: false };
---

<BaseLayout title="Eventos - Open PRP">
  <div data-module="events" class="space-y-4">
    <PageHeader title="Eventos" createLabel="Nuevo evento" createModule="events" />
    {items.length === 0 ? (
      <div class="text-string-muted text-sm">Sin eventos</div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {items.map(ev => {
          const cat = ev.category_id && catMap[ev.category_id];
          return (
            <div class={`relative rounded-xl border p-4 transition-all hover:shadow-sm ${
              ev.status === "cancelled" ? "border-red-200 dark:border-red-700 bg-red-50/30 dark:bg-red-900/20 opacity-60" :
              ev.status === "completed" ? "border-green-200 dark:border-green-700 bg-green-50/30 dark:bg-green-900/20" :
              ev.status === "confirmed" ? "border-blue-200 dark:border-blue-700 bg-blue-50/30 dark:bg-blue-900/20" :
              "border-border bg-panel"
            }`}>
              <div class="flex items-start justify-between gap-2 mb-2">
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium text-string leading-snug">{ev.description}</div>
                </div>
                <span class={`shrink-0 text-xs px-2 py-0.5 rounded font-medium ${statusColor[ev.status]}`}>{statusLabels[ev.status]}</span>
              </div>
              <div class="flex items-center gap-3 text-xs text-string-muted mb-2">
                <span class="font-semibold">📅 {new Date(ev.start_date).toLocaleDateString("es")}</span>
                {ev.end_date && <span class="font-semibold">→ {new Date(ev.end_date).toLocaleDateString("es")}</span>}
                {ev.is_all_day && <span>🌙</span>}
              </div>
              <div class="flex items-center gap-2 text-xs text-string-muted">
                {cat && <span>{cat.icon || "📁"} {cat.name}</span>}
                {ev.location && <span>📍 {ev.location}</span>}
              </div>
              <div class="flex justify-end gap-2 mt-3 pt-2 border-t border-border">
                <button data-edit-events={ev.id} class="text-indigo-600 hover:text-indigo-800 text-xs font-medium cursor-pointer">Editar</button>
                <button data-delete-events={ev.id} class="text-red-600 hover:text-red-800 text-xs font-medium cursor-pointer">Eliminar</button>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
  <CrudModal client:load module="events" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="evento" />
  <DeleteHandler module="events" label="evento" />
</BaseLayout>
