---
import "@/styles/global.css";
import { SignInButton, SignUpButton } from "@clerk/astro/components";
import ThemeToggle from "@/components/ui/ThemeToggle";

const { userId } = Astro.locals.auth();
if (userId) return Astro.redirect("/dashboard");
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Iniciar sesión - Open PRP</title>
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem("theme") || "system";
          if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="bg-surface text-string min-h-screen">
    <div class="flex items-center justify-center min-h-screen bg-surface">
      <div class="text-center space-y-4">
        <h1 class="text-2xl font-bold text-indigo-600">Open PRP</h1>
        <p class="text-string-muted">Personal Resource Planning</p>
        <div class="flex justify-center gap-2">
          <SignInButton mode="modal" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
            Iniciar sesión
          </SignInButton>
          <SignUpButton mode="modal" class="px-4 py-2 border border-border rounded-lg hover:bg-nav-hover text-string">
            Registrarse
          </SignUpButton>
        </div>
        <div class="flex justify-center pt-4">
          <ThemeToggle client:load />
        </div>
      </div>
    </div>
  </body>
</html>
