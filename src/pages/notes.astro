---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import DeleteHandler from "@/components/ui/DeleteHandler.astro";
import CrudModal from "@/components/ui/CrudModal.tsx";
import { NoteRepository } from "@/lib/modules/notes/repository.ts";
const userId = Astro.locals.userId;
const items = (await new NoteRepository().findAll(userId)) ?? [];

const colorMap: Record<string, string> = {
  blue: "#3b82f6", green: "#22c55e", yellow: "#eab308",
  pink: "#ec4899", purple: "#a855f7",
};

const fields = [
  { name: "title", label: "Título", type: "text" as const },
  { name: "content", label: "Contenido", type: "textarea" as const },
  { name: "color", label: "Color", type: "color" as const },
  { name: "is_pinned", label: "Fijada", type: "checkbox" as const },
];
const defaultForm = { title: "", content: "", color: "", is_pinned: false };
---

<BaseLayout title="Notas - Open PRP">
  <div data-module="notes" class="space-y-4">
    <PageHeader title="Notas" createLabel="Nueva nota" createModule="notes" />
    {items.length === 0 ? (
      <p class="text-center text-string-muted py-8">Sin notas</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.map(note => {
          const raw = note.color ?? "";
          const hex = raw.startsWith("#") ? raw : (colorMap[raw] ?? "");
          const hasColor = !!hex;
          return (
            <div key={note.id} class={`rounded-xl p-4 shadow-sm border border-border bg-panel ${hasColor ? "border-l-4" : ""} ${note.is_pinned ? "ring-2 ring-indigo-300" : ""}`} style={hasColor ? `border-left-color: ${hex}; background-color: ${hex}08` : ""}>
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-semibold text-string truncate">{note.title || "Sin título"}</h3>
                <div class="flex gap-1 shrink-0">
                  <button data-edit-notes={note.id} class="text-xs font-medium text-indigo-600 hover:text-indigo-800 cursor-pointer">Editar</button>
                  <button data-delete-notes={note.id} class="text-xs font-medium text-red-600 hover:text-red-800 cursor-pointer">Eliminar</button>
                </div>
              </div>
              {note.content && <p class="mt-2 text-sm text-nav whitespace-pre-wrap line-clamp-3">{note.content}</p>}
              <div class="mt-3 text-xs text-string-muted">{new Date(note.updated_at).toLocaleDateString("es")}</div>
            </div>
          );
        })}
      </div>
    )}
  </div>
  <CrudModal client:load module="notes" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="nota" />
  <DeleteHandler module="notes" label="nota" />
</BaseLayout>
