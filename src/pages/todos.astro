---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import DataTable from "@/components/ui/DataTable.astro";
import DeleteHandler from "@/components/ui/DeleteHandler.astro";
import ToggleHandler from "@/components/ui/ToggleHandler.astro";
import CrudModal from "@/components/ui/CrudModal";
import { TodoRepository } from "@/lib/modules/todos/repository";
const userId = Astro.locals.userId;
const filter = Astro.url.searchParams.get("filter") || "all";
const q: any = {};
if (filter === "pending") q.is_completed = false;
if (filter === "done") q.is_completed = true;
const result = await new TodoRepository().findAll(userId, q);
const items = result.data ?? result ?? [];
const fields = [
  { name: "title", label: "Título", type: "text" as const, required: true },
  { name: "description", label: "Descripción", type: "textarea" as const },
  { name: "due_date", label: "Fecha de vencimiento", type: "date" as const },
  { name: "priority", label: "Prioridad", type: "select" as const, options: [{ value: "1", label: "1 - Baja" }, { value: "2", label: "2 - Media" }, { value: "3", label: "3 - Alta" }] },
  { name: "category", label: "Categoría", type: "text" as const },
];
const defaultForm = { title: "", description: "", due_date: "", priority: 1, category: "" };
---

<BaseLayout title="Tareas - Open PHRP">
  <div data-module="todos" class="space-y-4">
    <PageHeader title="Tareas" createLabel="Nueva tarea" createModule="todos" />
    <div class="flex gap-2">
      {[["all", "Todas"], ["pending", "Pendientes"], ["done", "Completadas"]].map(([v, l]) => (
        <a href={v === "all" ? "/todos" : `/todos?filter=${v}`}
           class={`px-3 py-1.5 text-sm rounded-lg ${filter === v ? "bg-indigo-100 text-indigo-700 font-medium" : "bg-surface-alt text-nav hover:bg-nav-hover"}`}>{l}</a>
      ))}
    </div>
    <DataTable columns={["", "Título", "Prioridad", "Categoría", "Vence"]} emptyMessage="Sin tareas">
      {items.map(t => (
        <tr key={t.id} class={`hover:bg-nav-hover ${t.is_completed ? "opacity-50" : ""}`}>
          <td class="px-4 py-3"><input type="checkbox" checked={t.is_completed} data-toggle-todos={t.id} class="w-4 h-4 accent-indigo-600 cursor-pointer" /></td>
          <td class={`px-4 py-3 ${t.is_completed ? "line-through text-text-muted" : ""}`}>{t.title}</td>
          <td class="px-4 py-3">{t.priority >= 3 ? <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded">Alta</span> : t.priority >= 2 ? <span class="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded">Media</span> : <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">Baja</span>}</td>
          <td class="px-4 py-3">{t.category ? <span class="text-xs bg-gray-100 px-2 py-0.5 rounded">{t.category}</span> : "-"}</td>
          <td class="px-4 py-3">{t.due_date ? new Date(t.due_date).toLocaleDateString("es") : "-"}</td>
          <td class="px-4 py-3 text-right space-x-2">
            <button data-edit-todos={t.id} class="text-indigo-600 hover:text-indigo-800 text-xs font-medium cursor-pointer">Editar</button>
            <button data-delete-todos={t.id} class="text-red-600 hover:text-red-800 text-xs font-medium cursor-pointer">Eliminar</button>
          </td>
        </tr>
      ))}
    </DataTable>
  </div>
  <CrudModal client:load module="todos" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular="tarea" />
  <DeleteHandler module="todos" label="tarea" />
  <ToggleHandler module="todos" key="is_completed" endpoint="/api/todos/toggle" />
</BaseLayout>
