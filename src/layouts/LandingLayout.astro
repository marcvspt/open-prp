---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/landing/Header.astro";
import Footer from "@/components/landing/Footer.astro";
import ClerkLocaleBridge from "@/components/ui/ClerkLocaleBridge.tsx";
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_LOCALE, getLocaleDict, LOCALES, resolveLocale } from "@/lib/i18n/locale.ts";
import { SITE_DATA } from "@/lib/site.ts";

const locale = resolveLocale(Astro.currentLocale);
const { seoTitle, seoDescription } = getLocaleDict(locale).landing;
const landingUrl = (language: typeof locale) => new URL(getRelativeLocaleUrl(language, "/"), Astro.site ?? Astro.url);
const canonical = landingUrl(locale);
---

<BaseLayout title={seoTitle}>
  <Fragment slot="head">
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonical.href} />
    {LOCALES.map(language => <link rel="alternate" hreflang={language} href={landingUrl(language).href} />)}
    <link rel="alternate" hreflang="x-default" href={landingUrl(DEFAULT_LOCALE).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_DATA.name} />
    <meta property="og:title" content={`${SITE_DATA.name} | ${seoTitle}`} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === "es" ? "es_MX" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_MX"} />
  </Fragment>
  <ClerkLocaleBridge client:load locale={locale} />
  <Header />
  <main><slot /></main>
  <Footer />
</BaseLayout>
