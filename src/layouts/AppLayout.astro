---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Show, SignInButton, SignUpButton } from "@clerk/astro/components";
import ThemeToggle from "@/components/ui/ThemeToggle.tsx";
import Sidebar from "@/components/app/ui/Sidebar.astro";
import MenuIcon from "@/assets/menu.svg";
import { BTN_LOGIN, BTN_SIGNUP } from "@/lib/general-fields.ts";
import { labels } from "@/lib/labels.ts";

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
  </Fragment>
  <Show when="signed-in">
    <Sidebar currentPath={currentPath} />
    <div
      id="sidebar-overlay"
      class="fixed inset-0 z-30 bg-overlay hidden lg:hidden"
    >
    </div>
    <button
      id="sidebar-toggle"
      class="fixed top-3 left-3 z-50 flex lg:hidden items-center justify-center w-10 h-10 rounded-lg bg-panel border border-border text-nav hover:bg-nav-hover transition-colors shadow-sm"
      aria-label={labels.nav.openMenu}
    >
      <MenuIcon class="w-5 h-5" />
    </button>
    <main
      id="main-content"
      class="min-h-screen bg-surface pl-0 transition-all duration-300 lg:pl-64"
    >
      <div class="p-4 lg:p-6 pt-16 lg:pt-6">
        <slot />
      </div>
    </main>
  </Show>
  <Show when="signed-out">
    <div class="flex items-center justify-center min-h-screen bg-surface">
      <div class="text-center space-y-4">
        <h1 class="text-2xl font-bold">Open PRP</h1>
        <p class="text-string-muted">Personal Resource Planning</p>
        <div class="flex justify-center gap-2">
          <SignInButton mode="modal">
            <button
              class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover"
            >
              {BTN_LOGIN}</button
            >
          </SignInButton>
          <SignUpButton mode="modal">
            <button
              class="px-4 py-2 border border-border rounded-lg hover:bg-nav-hover text-string"
              >{BTN_SIGNUP}</button
            >
          </SignUpButton>
        </div>
        <div class="flex justify-center pt-4">
          <ThemeToggle client:load />
        </div>
      </div>
    </div>
  </Show>
</BaseLayout>

<script>
  import { initSidebar, initUserAreaForward } from "@/lib/ui/sidebar.ts";

  initUserAreaForward();
  document.addEventListener("astro:page-load", () => initSidebar());
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js");
  }
</script>
