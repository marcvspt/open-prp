---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Show } from "@clerk/astro/components";
import ThemeToggle from "@/components/ui/ThemeToggle.tsx";
import ClerkLocaleBridge from "@/components/ui/ClerkLocaleBridge.tsx";
import Sidebar from "@/components/app/ui/Sidebar.astro";
import MenuIcon from "@/assets/menu.svg";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const locale = resolveLocale(Astro.currentLocale);
const loginPath = getRelativeLocaleUrl(locale, "/app/login");
const t = getLocaleDict(locale);
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <meta name="theme-color" content="#4f46e5" />
  </Fragment>
  <ClerkLocaleBridge client:load locale={locale} />
  <Show when="signed-in">
    <Sidebar currentPath={currentPath} />
    <div
      id="sidebar-overlay"
      class="fixed inset-0 z-30 bg-overlay hidden lg:hidden"
    >
    </div>
    <button
      id="sidebar-toggle"
      class="fixed top-3 left-3 z-50 flex lg:hidden items-center justify-center w-10 h-10 rounded-lg bg-panel border border-border text-nav hover:bg-nav-hover transition-colors shadow-sm"
      aria-label={t.nav.openMenu}
    >
      <MenuIcon class="w-5 h-5" />
    </button>
    <main
      id="main-content"
      class="min-h-screen bg-surface pl-0 transition-all duration-300 lg:pl-64"
    >
      <div class="p-4 lg:p-6 pt-16 lg:pt-6">
        <slot />
      </div>
    </main>
  </Show>
  <Show when="signed-out">
    <div
      class="flex items-center justify-center min-h-screen bg-surface"
      data-login-redirect
    >
      <div class="text-center space-y-4 px-6">
        <h1 class="text-2xl font-bold">Open PRP</h1>
        <div>
          <a
            href={loginPath}
            class="inline-block px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-hover cursor-pointer"
          >
            {t.common.login}
          </a>
        </div>
        <div class="flex justify-center">
          <ThemeToggle client:load locale={locale} />
        </div>
      </div>
    </div>
  </Show>
</BaseLayout>

<script>
  import { initSidebar, initUserAreaForward } from "@/lib/ui/sidebar.ts";

  initUserAreaForward();
  document.addEventListener("astro:page-load", () => {
    initSidebar();
    const redirectLink = document.querySelector("[data-login-redirect] a");
    if (redirectLink instanceof HTMLAnchorElement)
      window.location.replace(redirectLink.href);
  });
</script>
