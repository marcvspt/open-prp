---
import "@/styles/global.css";
import { Show, UserButton, SignInButton, SignUpButton } from "@clerk/astro/components";
import ThemeToggle from "@/components/ui/ThemeToggle";
import CurrencySelect from "@/components/ui/CurrencySelect";

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title ?? "Open PRP"}</title>
        <script is:inline>
            (function() {
                try {
                    var t = localStorage.getItem("theme") || "system";
                    if (t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
                        document.documentElement.classList.add("dark");
                    }
                } catch(e) {}
            })();
        </script>
    </head>
    <body class="bg-surface text-text min-h-screen">
        <Show when="signed-in">
            <div class="flex h-screen overflow-hidden">
                <aside class="w-64 bg-panel border-r border-border flex flex-col shrink-0 overflow-y-auto">
                    <div class="p-4 border-b border-border">
                        <h1 class="text-lg font-bold text-indigo-600">Open PRP</h1>
                        <p class="text-xs text-text-muted">Personal Resource Planning</p>
                    </div>
                    <nav class="flex-1 p-3 space-y-1 text-sm">
                        <a href="/dashboard" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath === "/dashboard" ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                            Dashboard
                        </a>
                        <div class="pt-3 pb-1 text-xs font-semibold text-text-muted uppercase tracking-wider">Finanzas</div>
                        <a href="/transactions" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/transactions") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Transacciones
                        </a>
                        <a href="/credit-cards" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/credit-cards") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                            Tarjetas
                        </a>
                        <a href="/installments" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/installments") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                            Plazos
                        </a>
                        <a href="/recurring-payments" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/recurring-payments") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            Pagos recurrentes
                        </a>
                        <a href="/cashback" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/cashback") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Cashback
                        </a>
                        <a href="/payment-methods" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/payment-methods") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                            Métodos de pago
                        </a>
                        <div class="pt-3 pb-1 text-xs font-semibold text-text-muted uppercase tracking-wider">Organización</div>
                        <a href="/shopping" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/shopping") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
                            Compras
                        </a>
                        <a href="/tasks" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/tasks") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                            Tareas
                        </a>
                        <a href="/notes" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/notes") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Notas
                        </a>
                        <a href="/events" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/events") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            Eventos
                        </a>
                        <a href="/pantry" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/pantry") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                            Despensa
                        </a>
                        <div class="pt-3 pb-1 text-xs font-semibold text-text-muted uppercase tracking-wider">General</div>
                        <a href="/categories" class={`flex items-center gap-2 px-3 py-2 rounded-lg transition ${currentPath.startsWith("/categories") ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                            Categorías
                        </a>
                    </nav>
                    <div class="p-3 border-t border-border space-y-1">
                        <ThemeToggle client:load />
                        <CurrencySelect client:load />
                        <div class="flex items-center gap-2 px-3 py-2 cursor-pointer" data-user-area>
                            <UserButton />
                            <span class="text-xs text-text-muted"><Show when="signed-in">Mi cuenta</Show></span>
                        </div>
                    </div>
                </aside>
                <main class="flex-1 overflow-y-auto p-6 bg-surface">
                    <slot />
                </main>
            </div>
        </Show>
        <Show when="signed-out">
            <div class="flex items-center justify-center min-h-screen bg-surface">
                <div class="text-center space-y-4">
                    <h1 class="text-2xl font-bold text-indigo-600">Open PRP</h1>
                    <p class="text-text-muted">Personal Resource Planning</p>
                    <div class="flex justify-center gap-2">
                        <SignInButton mode="modal" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                            Iniciar sesión
                        </SignInButton>
                        <SignUpButton mode="modal" class="px-4 py-2 border border-border rounded-lg hover:bg-nav-hover text-text">
                            Registrarse
                        </SignUpButton>
                    </div>
                    <div class="flex justify-center pt-4">
                        <ThemeToggle client:load />
                    </div>
                </div>
            </div>
        </Show>
    </body>
</html>

<script>
  document.addEventListener("click", function(e) {
    const area = (e.target as HTMLElement).closest("[data-user-area]");
    if (!area) return;
    const btn = area.querySelector("button");
    if (btn && btn !== e.target && !btn.contains(e.target as Node)) {
      btn.click();
    }
  });
</script>
