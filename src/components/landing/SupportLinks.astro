---
import { SITE_LINKS } from "@/lib/links.ts";
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";
import GithubIcon from "@/assets/github.svg";

interface Props {
  titleId: string;
  locale: LocaleCode;
}

const { titleId, locale } = Astro.props;
const t = getLocaleDict(locale);
---

<p id={titleId} class="text-sm font-semibold">{t.landing.support}</p>
<p class="mt-1 text-xs text-string-muted">{t.landing.supportDescription}</p>
<div class="mt-3 flex flex-col gap-1">
  <a href={SITE_LINKS.buyMeACoffee} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center rounded-lg px-3 py-2.5 text-sm font-medium text-primary-text hover:bg-primary-bg transition-colors">
    {t.landing.buyMeACoffee}
    <span class="sr-only"> — {t.landing.opensNewTab}</span>
  </a>
  <a href={SITE_LINKS.githubSponsors} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-primary-text hover:bg-primary-bg transition-colors">
    <GithubIcon class="h-4 w-4" aria-hidden="true" />
    {t.landing.githubSponsors}
    <span class="sr-only"> — {t.landing.opensNewTab}</span>
  </a>
</div>
