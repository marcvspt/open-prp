---
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);
---

<footer class="border-t border-border bg-panel" id="about">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="flex flex-col items-center gap-1 sm:items-start">
        <span class="text-lg font-bold text-primary">Open PRP</span>
        <p class="text-sm text-string-muted">Open Personal Resource Planning</p>
      </div>
      <div class="flex flex-col items-center gap-2 sm:items-end">
        <p class="text-xs text-string-muted">
          {t.landing.developedWith} <a
            href="https://opencode.ai"
            class="text-primary hover:text-primary-hover transition-colors"
            target="_blank"
            rel="noopener">OpenCode</a
          >
        </p>
        <p class="text-xs text-string-muted">
          &copy; {new Date().getFullYear()} Open PRP
        </p>
      </div>
    </div>
  </div>
</footer>
