---
import { getRelativeLocaleUrl } from "astro:i18n";
import ThemeToggle from "@/components/ui/ThemeToggle.tsx";
import LocaleSwitcher from "@/components/ui/LocaleSwitcher.tsx";
import GithubIcon from "@/assets/github.svg";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
const homeHref = getRelativeLocaleUrl(locale, "/");
const loginHref = getRelativeLocaleUrl(locale, "/app/login");

const LANDING_LINKS = [
  { href: "#features", label: t.landing.navFeatures },
  { href: "https://www.marcvspt.tech", label: t.landing.navAbout, external: true },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-surface/80 backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href={homeHref} class="flex items-center gap-2">
      <span class="text-lg font-bold text-primary">Open PRP</span>
    </a>
    <button
      id="mobile-menu-btn"
      class="flex lg:hidden items-center justify-center w-8 h-8 text-string-muted hover:text-string transition-colors cursor-pointer"
      aria-label={t.landing.ariaMenu}
      aria-expanded="false"
    >
      <svg
        id="hamburger-icon"
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="close-icon"
        class="w-6 h-6 hidden"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <nav id="mobile-menu" class="hidden lg:flex items-center gap-6">
      {
        LANDING_LINKS.map(({ href, label, external }) => (
          <a
            href={href}
            {...(external ? { target: "_blank", rel: "noopener" } : {})}
            class="shrink-0 whitespace-nowrap text-sm text-string-muted hover:text-string transition-colors"
          >
            {label}
          </a>
        ))
      }
      <a
        href="https://github.com/marcvspt/open-prp"
        target="_blank"
        rel="noopener"
        class="flex items-center text-string-muted hover:text-string transition-colors py-1.5"
        aria-label={t.nav.ariaGithub}
      >
        <GithubIcon class="h-5 w-5" />
      </a>
      <a
        href={loginHref}
        class="shrink-0 whitespace-nowrap rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-hover transition-colors"
      >
        {t.landing.login}
      </a>
      <ThemeToggle client:load locale={locale} />
      <LocaleSwitcher client:load locale={locale} className="w-32 shrink-0" />
    </nav>
  </div>
  <div
    id="mobile-dropdown"
    class="lg:hidden overflow-hidden transition-all duration-300 max-h-0 border-transparent"
  >
    <div
      class="border-t border-border bg-surface/95 backdrop-blur-sm px-6 py-4 flex flex-col items-center space-y-3 text-center"
    >
      {
        LANDING_LINKS.map(({ href, label, external }) => (
          <a
            href={href}
            {...(external ? { target: "_blank", rel: "noopener" } : {})}
            class="text-sm text-string-muted hover:text-string transition-colors"
          >
            {label}
          </a>
        ))
      }
      <div class="flex flex-col items-center space-y-3 pt-2">
        <a
          href="https://github.com/marcvspt/open-prp"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2 text-sm text-string-muted hover:text-string transition-colors"
          aria-label={t.nav.ariaGithub}
        >
          <GithubIcon class="h-5 w-5" />
          {t.nav.ariaGithub}
        </a>
        <a
          href={loginHref}
          class="inline-block rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-hover transition-colors"
        >
          {t.landing.login}
        </a>
        <div class="w-36"><ThemeToggle client:load locale={locale} /></div>
        <LocaleSwitcher client:load locale={locale} className="w-36" />
      </div>
    </div>
  </div>
</header>

<style>
  #mobile-dropdown.open {
    max-height: 380px;
    border-color: var(--color-border);
  }
</style>

<script>
  import { initLandingMenu } from "@/lib/ui/landing-menu.ts";

  document.addEventListener("astro:page-load", () => initLandingMenu());
</script>
