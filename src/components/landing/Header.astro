---
import ThemeToggle from "@/components/ui/ThemeToggle.tsx";
import GithubIcon from "@/assets/github.svg";

const LANDING_LINKS = [
  { href: "#features", label: "Características" },
  { href: "https://www.marcvspt.tech", label: "Sobre Mí", external: true },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-surface/80 backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2">
      <span class="text-lg font-bold text-primary">Open PRP</span>
    </a>
    <nav class="flex items-center gap-6">
      {
        LANDING_LINKS.map(({ href, label, external }) => (
          <a
            href={href}
            {...(external ? { target: "_blank", rel: "noopener" } : {})}
            class="shrink-0 whitespace-nowrap text-sm text-string-muted hover:text-string transition-colors"
          >
            {label}
          </a>
        ))
      }
      <a
        href="/app"
        class="shrink-0 whitespace-nowrap rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-hover transition-colors"
      >
        Ir a la app
      </a>
      <a
        href="https://github.com/marcvspt/open-prp"
        target="_blank"
        rel="noopener"
        class="flex items-center text-string-muted hover:text-string transition-colors py-1.5"
        aria-label="GitHub"
      >
        <GithubIcon class="h-5 w-5" />
      </a>
      <ThemeToggle client:load />
    </nav>
  </div>
</header>
