---
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";
import ChevronIcon from "@/assets/chevron.svg";
import SupportLinks from "@/components/landing/SupportLinks.astro";

interface Props {
  id: string;
  locale: LocaleCode;
  mobile?: boolean;
}

const { id, locale, mobile = false } = Astro.props;
const t = getLocaleDict(locale);
---

{mobile ? (
  <details data-support-disclosure class="group w-full max-w-xs text-left">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-primary-text hover:bg-primary-bg [&::-webkit-details-marker]:hidden">
      {t.landing.support}
      <ChevronIcon class="h-4 w-4 group-open:rotate-180" aria-hidden="true" />
    </summary>
    <div id={id} aria-labelledby={`${id}-title`} class="mt-2 rounded-xl border border-border bg-panel p-4 text-string">
      <SupportLinks titleId={`${id}-title`} locale={locale} />
    </div>
  </details>
) : (
<Fragment>
<button
  type="button"
  popovertarget={id}
  aria-controls={id}
  aria-expanded="false"
  data-support-trigger
  class="flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-lg px-2 py-1.5 text-sm font-medium text-primary-text hover:bg-primary-bg transition-colors cursor-pointer"
>
  {t.landing.support}
  <ChevronIcon class="h-4 w-4" aria-hidden="true" />
</button>
<div
  id={id}
  popover="auto"
  data-support-popover
  aria-labelledby={`${id}-title`}
  class="fixed inset-auto m-0 w-[min(18rem,calc(100vw-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-xl border border-border bg-panel p-4 text-left text-string shadow-xl"
>
  <SupportLinks titleId={`${id}-title`} locale={locale} />
</div>
</Fragment>
)}

<script>
  import { initSupportPopovers } from "@/lib/ui/support-popover.ts";

  document.addEventListener("astro:page-load", initSupportPopovers);
</script>
