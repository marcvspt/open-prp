---
import LogoIcon from "@/assets/logo.svg";
import { SITE_DATA } from "@/lib/site.ts";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<LogoIcon
  role="img"
  aria-label={SITE_DATA.name}
  class:list={["block w-auto shrink-0", className ?? "h-8"]}
/>
