---
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";
import type { DashboardMonthData } from "@/lib/types/dashboard.ts";
import DashboardCardDebts from "@/components/app/dashboard/DashboardCardDebts.astro";
import DashboardBalanceSummary from "@/components/app/dashboard/DashboardBalanceSummary.tsx";

interface Props {
  data: DashboardMonthData;
  month: string;
  locale: LocaleCode;
}

const { data, month: selectedMonth, locale } = Astro.props;
const t = getLocaleDict(locale);

const {
  cards, services, cardDebts, upcomingEvents, pendingTasks, overdueTasks,
  activeShopping, balances, hasUnassignedCarryover,
} = data;

const creditCards = cards.filter(c => c.type === "credit");
---

<div class="space-y-6">
  <DashboardBalanceSummary
    client:load
    balances={balances}
    hasUnassignedCarryover={hasUnassignedCarryover}
    preferredCurrency={Astro.locals.user?.preferred_currency}
    creditCardCount={creditCards.length}
    locale={locale}
  />

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
      <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statPendingTasks}</p>
      <p class="text-xl font-bold mt-1 text-sky-600">{pendingTasks.length}</p>
      {overdueTasks.length > 0 && <p class="text-xs text-danger mt-0.5">{t.dashboard.overdueCount(overdueTasks.length)}</p>}
    </div>
    <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
      <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statUpcomingEvents}</p>
      <p class="text-xl font-bold mt-1 text-rose-600">{upcomingEvents.length}</p>
    </div>
    <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
      <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statActiveShopping}</p>
      <p class="text-xl font-bold mt-1 text-amber-600">{activeShopping.length}</p>
    </div>
    <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
      <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statRecurring}</p>
      <p class="text-xl font-bold mt-1 text-purple-600">{services.length}</p>
    </div>
  </div>

  <DashboardCardDebts cards={creditCards} debts={cardDebts} month={selectedMonth} locale={locale} />
</div>
