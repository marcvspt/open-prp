---
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";
import type { DashboardMonthData } from "@/lib/types/dashboard.ts";
import DashboardCardDebts from "@/components/app/dashboard/DashboardCardDebts.astro";
import DashboardBalanceSummary from "@/components/app/dashboard/DashboardBalanceSummary.tsx";

interface Props {
  data: DashboardMonthData;
  month: string;
  locale: LocaleCode;
}

const { data, month: selectedMonth, locale } = Astro.props;
const t = getLocaleDict(locale);

const {
  cards, services, cardDebts, upcomingEvents, pendingTasks, overdueTasks,
  activeShopping, balances, hasUnassignedCarryover,
} = data;

const creditCards = cards.filter(c => c.type === "credit");
const counts = [
  { label: t.dashboard.statCreditCards, value: creditCards.length },
  {
    label: t.dashboard.statPendingTasks,
    value: pendingTasks.length,
    detail: overdueTasks.length > 0 ? t.dashboard.overdueCount(overdueTasks.length) : undefined,
  },
  { label: t.dashboard.statUpcomingEvents, value: upcomingEvents.length },
  { label: t.dashboard.statActiveShopping, value: activeShopping.length },
  { label: t.dashboard.statRecurring, value: services.length },
];
---

<div class="grid gap-4 sm:gap-5">
  <DashboardBalanceSummary
    client:load
    balances={balances}
    hasUnassignedCarryover={hasUnassignedCarryover}
    preferredCurrency={Astro.locals.user?.preferred_currency}
    locale={locale}
  />

  <dl class="grid grid-cols-2 gap-4 border-y border-border px-4 py-3 sm:px-5 md:grid-cols-5">
    {counts.map(({ label, value, detail }) => (
      <div class="min-w-0 max-md:last:odd:col-span-2">
        <dt class="text-xs font-medium text-string-muted">{label}</dt>
        <dd class="mt-1 text-base font-semibold tabular-nums text-string">
          {value}
          {detail && <span class="block text-xs font-medium text-danger-text">{detail}</span>}
        </dd>
      </div>
    ))}
  </dl>

  <DashboardCardDebts cards={creditCards} debts={cardDebts} month={selectedMonth} locale={locale} />
</div>
