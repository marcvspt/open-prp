---
import { getLocaleDict } from "@/lib/i18n/locale.ts";
import { loadDashboardMonth } from "@/lib/dashboard/load.ts";
import { daysUntilPaymentDue, isPaymentLate } from "@/lib/date.ts";
import { formatCurrency } from "@/lib/format.ts";

interface Props {
  userId: string;
  month: string;
  locale: string;
}

const { userId, month: selectedMonth, locale } = Astro.props;
const t = getLocaleDict(locale);

const monthData = await loadDashboardMonth(userId, selectedMonth);
const {
  cards, services, cardDebts, servicePayments, upcomingEvents,
  pendingTasks, overdueTasks, activeShopping, paymentMethods,
  calculatedDebts, cardTotals, incomes, expenses, recentTx,
  installmentTotal,
} = monthData;

const creditCards = cards.filter(c => c.type === "credit");
const creditCardDebts = cardDebts.filter(d => cards.some(c => c.id === d.card_id && c.type === "credit"));
const incomeSvcs = servicePayments.filter(sp => sp.type === "income");
const expenseSvcs = servicePayments.filter(sp => sp.type === "expense");
const recurringExpensesTotal = expenseSvcs.reduce((sum, sp) => sum + Number(sp.amount), 0);

function dueDaysBadge(days: number): string {
  if (days <= 3) return "bg-danger-bg text-danger-text";
  if (days <= 8) return "bg-warning-bg text-warning-text";
  return "bg-success-bg text-success-text";
}
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statIncomes}</p>
    <p class="text-xl font-bold mt-1 text-success">{formatCurrency(incomes)}</p>
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statExpenses}</p>
    <p class="text-xl font-bold mt-1 text-danger">{formatCurrency(expenses)}</p>
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statBalance}</p>
    <p class={`text-xl font-bold mt-1 ${incomes - expenses >= 0 ? "text-success" : "text-danger"}`}>{formatCurrency(incomes - expenses)}</p>
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statCreditCards}</p>
    <p class="text-xl font-bold mt-1 text-primary">{creditCards.length}</p>
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statInstallments}</p>
    <p class="text-xl font-bold mt-1 text-warning">{formatCurrency(installmentTotal)}</p>
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statRecurringExpenses}</p>
    <p class="text-xl font-bold mt-1 text-danger">{formatCurrency(recurringExpensesTotal)}</p>
  </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statPendingTasks}</p>
    <p class="text-xl font-bold mt-1 text-sky-600">{pendingTasks.length}</p>
    {overdueTasks.length > 0 && <p class="text-xs text-danger mt-0.5">{t.dashboard.overdueCount(overdueTasks.length)}</p>}
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statUpcomingEvents}</p>
    <p class="text-xl font-bold mt-1 text-rose-600">{upcomingEvents.length}</p>
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statActiveShopping}</p>
    <p class="text-xl font-bold mt-1 text-amber-600">{activeShopping.length}</p>
  </div>
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <p class="text-xs text-string-muted uppercase tracking-wider">{t.dashboard.statRecurring}</p>
    <p class="text-xl font-bold mt-1 text-purple-600">{services.length}</p>
  </div>
</div>

{creditCardDebts.length > 0 && (
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <h2 class="text-base font-semibold text-string mb-3">{t.dashboard.cardDebtsTitle}</h2>
    <div class="space-y-2">
      {creditCardDebts.map(d => {
        const card = cards.find(c => c.id === d.card_id);
        const dueIn = card && card.payment_due_day != null ? daysUntilPaymentDue(selectedMonth, card.cutoff_day, card.payment_due_day) : 0;
        const paidLate = d.is_paid && isPaymentLate(selectedMonth, card?.cutoff_day ?? null, card?.payment_due_day ?? null, d.paid_at);
        return (
          <div class="flex items-center justify-between text-sm py-1">
            <div class="flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${d.is_paid ? (paidLate ? "bg-danger" : "bg-success") : "bg-warning"}`} />
              <span>{card?.name ?? "?"}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class={`font-mono ${d.is_paid ? (paidLate ? "text-danger" : "text-success line-through") : "text-danger"}`}>
                {formatCurrency(d.is_paid ? 0 : Math.max(0, d.statement_balance - d.paid_amount))}
              </span>
              {!d.is_paid && card && (
                <span class={`text-xs px-2 py-0.5 rounded font-medium ${dueDaysBadge(dueIn)}`}>
                  {dueIn <= 0 ? t.badge.overdue : t.dashboard.dueInDays(dueIn)}
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}

{incomeSvcs.length > 0 && (
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <h2 class="text-base font-semibold text-string mb-3">{t.dashboard.recurringIncomesTitle}</h2>
    <div class="space-y-2">
      {incomeSvcs.map(sp => {
        const svc = services.find(s => s.id === sp.payment_id);
        return (
          <div class="flex items-center justify-between text-sm py-1">
            <div class="flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${sp.is_paid ? "bg-success" : "bg-warning"}`} />
              <span>{svc?.name ?? "?"}</span>
            </div>
            <span class="font-mono text-success">+{formatCurrency(sp.amount)}</span>
          </div>
        );
      })}
    </div>
  </div>
)}

{expenseSvcs.length > 0 && (
  <div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
    <h2 class="text-base font-semibold text-string mb-3">{t.dashboard.recurringExpensesTitle}</h2>
    <div class="space-y-2">
      {expenseSvcs.map(sp => {
        const svc = services.find(s => s.id === sp.payment_id);
        return (
          <div class="flex items-center justify-between text-sm py-1">
            <div class="flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${sp.is_paid ? "bg-success" : "bg-warning"}`} />
              <span>{svc?.name ?? "?"}</span>
            </div>
            <span class="font-mono text-danger">-{formatCurrency(sp.amount)}</span>
          </div>
        );
      })}
    </div>
  </div>
)}

<div class="bg-panel rounded-xl border border-border p-4 shadow-sm">
  <h2 class="text-base font-semibold text-string mb-3">{t.dashboard.monthTransactionsTitle}</h2>
  {recentTx.length === 0 ? (
    <p class="text-sm text-string-muted">{t.empty.transactions}</p>
  ) : (
    <div class="space-y-2">
      {recentTx.map(tx => (
        <div class="flex items-center justify-between text-sm py-1">
          <div class="flex items-center gap-2">
            <span class={`w-2 h-2 rounded-full ${tx.type === "income" ? "bg-success" : "bg-danger"}`} />
            <span>{tx.description || t.dashboard.noDescription}</span>
          </div>
          <span class={`font-medium ${tx.type === "income" ? "text-success" : "text-danger"}`}>
            {tx.type === "income" ? "+" : "-"}{formatCurrency(Number(tx.amount))}
          </span>
        </div>
      ))}
    </div>
  )}
</div>