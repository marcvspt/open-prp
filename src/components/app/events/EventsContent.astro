---
import { BTN_EDIT, BTN_DELETE } from "@/lib/i18n/general-fields.ts";
import { formatDate } from "@/lib/date.ts";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { EventRepository } from "@/lib/modules/events/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { displayCategoryName } from "@/lib/i18n/category-labels.ts";
import { getLocaleDict } from "@/lib/i18n/locale.ts";

interface Props {
  userId: string;
  locale: string;
}

const { userId, locale } = Astro.props;
const t = getLocaleDict(locale);
const [itemsResult, evCategories] = await Promise.all([
  new EventRepository().findAll(userId),
  new CategoryRepository().findBySections(userId, ["events"]),
]);
const items = itemsResult.data ?? [];
const catMap = Object.fromEntries(evCategories.map(c => [c.id, c]));
const statusLabels: Record<string, string> = { pending: t.badge.pendingEvent, confirmed: t.badge.confirmed, completed: t.badge.completed, cancelled: t.badge.cancelled };
const statusColor: Record<string, string> = { pending: "bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300", confirmed: "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300", completed: "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300", cancelled: "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300" };
const fields = [
  { name: "description", label: t.field.description, type: "textarea" as const, required: true },
  { name: "category_id", label: t.field.category, type: "select" as const, options: [{ value: "", label: t.field.noCategory }, ...evCategories.map(c => ({ value: c.id, label: `${c.icon || "📁"} ${displayCategoryName(c, t)}` }))] },
  { name: "location", label: t.field.location, type: "text" as const },
  { name: "start_date", label: t.field.start, type: "date" as const, required: true },
  { name: "end_date", label: t.field.end, type: "date" as const },
  { name: "status", label: t.field.status, type: "select" as const, options: [{ value: "pending", label: t.badge.pendingEvent }, { value: "confirmed", label: t.badge.confirmed }, { value: "completed", label: t.badge.completed }, { value: "cancelled", label: t.badge.cancelled }] },
  { name: "is_all_day", label: t.field.allDay, type: "checkbox" as const },
];
const defaultForm = { description: "", category_id: "", location: "", start_date: "", end_date: "", status: "pending", is_all_day: false };
---

<div data-module="events" class="space-y-4">
  <PageHeader title={t.page.events} createLabel={t.cta.newEvent} createModule="events" />
  {items.length === 0 ? (
    <div class="text-string-muted text-sm">{t.empty.events}</div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {items.map(ev => {
        const cat = ev.category_id && catMap[ev.category_id];
        return (
          <div class={`relative rounded-xl border p-4 transition-all hover:shadow-sm ${
            ev.status === "cancelled" ? "border-red-200 dark:border-red-700 bg-red-50/30 dark:bg-red-900/20 opacity-60" :
            ev.status === "completed" ? "border-green-200 dark:border-green-700 bg-green-50/30 dark:bg-green-900/20" :
            ev.status === "confirmed" ? "border-blue-200 dark:border-blue-700 bg-blue-50/30 dark:bg-blue-900/20" :
            "border-border bg-panel"
          }`}>
            <div class="flex items-start justify-between gap-2 mb-2">
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-string leading-snug">{ev.description}</div>
              </div>
              <span class={`shrink-0 text-xs px-2 py-0.5 rounded font-medium ${statusColor[ev.status]}`}>{statusLabels[ev.status]}</span>
            </div>
            <div class="flex items-center gap-3 text-xs text-string-muted mb-2">
              <span class="font-semibold">📅 {formatDate(ev.start_date, locale)}</span>
              {ev.end_date && <span class="font-semibold">→ {formatDate(ev.end_date, locale)}</span>}
              {ev.is_all_day && <span>🌙</span>}
            </div>
            <div class="flex items-center gap-2 text-xs text-string-muted">
              {cat && <span>{cat.icon || "📁"} {displayCategoryName(cat, t)}</span>}
              {ev.location && <span>📍 {ev.location}</span>}
            </div>
            <div class="flex justify-end gap-2 mt-3 pt-2 border-t border-border">
              <button data-edit-events={ev.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">{BTN_EDIT(t)}</button>
              <button data-delete-events={ev.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">{BTN_DELETE(t)}</button>
            </div>
          </div>
        );
      })}
    </div>
  )}
</div>
<CrudModal client:load module="events" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular={t.singular.event} locale={locale} />
<DeleteHandler module="events" label={t.singular.event} />