---
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import PantryFilterable from "@/components/app/pantry/PantryFilterable.tsx";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { PantryRepository } from "@/lib/modules/pantry/repository.ts";
import { displayCategoryName } from "@/lib/i18n/category-labels.ts";
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";

interface Props {
  userId: string;
  locale: LocaleCode;
}

const { userId, locale } = Astro.props;
const t = getLocaleDict(locale);
const params = Astro.url.searchParams;
const filterQ = params.get("q") || "";
const filterCat = params.get("category_id") || "";
const pantryFilter: Record<string, unknown> = {};
if (filterQ) pantryFilter.q = filterQ;
if (filterCat) pantryFilter.category_id = filterCat;
const [categories, initialData] = await Promise.all([
  new CategoryRepository().findBySections(userId, ["pantry"]),
  new PantryRepository().findAll(userId, pantryFilter),
]);
const catOptions = [
  { value: "", label: t.field.noCategory },
  ...categories.map((c) => ({
    value: c.id,
    label: `${c.icon || "📦"} ${displayCategoryName(c, t)}`,
  })),
];
const fields = [
  {
    name: "description",
    label: t.field.item,
    type: "text" as const,
    required: true,
  },
  {
    name: "category_id",
    label: t.field.category,
    type: "select" as const,
    options: catOptions,
  },
  {
    name: "quantity",
    label: t.field.quantity,
    type: "number" as const,
    min: 0,
    step: "0.01",
  },
  { name: "notes", label: t.field.notes, type: "textarea" as const },
];
const defaultForm = {
  description: "",
  category_id: "",
  quantity: 1,
  notes: "",
};
---

<div data-module="pantry" class="space-y-4">
  <PageHeader
    title={t.page.pantry}
    createLabel={t.cta.newProduct}
    createModule="pantry"
    mobileOnlyCTA={true}
  />
  <PantryFilterable
    client:load
    categories={categories.map((c) => ({
      id: c.id,
      icon: c.icon,
      name: displayCategoryName(c, t),
    }))}
    initialData={JSON.stringify(initialData)}
    locale={locale}
  />
</div>
<CrudModal
  client:load
  module="pantry"
  fields={JSON.stringify(fields)}
  defaultForm={JSON.stringify(defaultForm)}
  titleSingular={t.singular.product}
  locale={locale}
/>
<DeleteHandler module="pantry" label={t.singular.product} />