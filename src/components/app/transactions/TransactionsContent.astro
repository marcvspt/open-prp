---
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import TransactionsFilterable from "@/components/app/transactions/TransactionsFilterable.tsx";
import { TransactionRepository } from "@/lib/modules/transactions/repository.ts";
import { PaymentMethodRepository } from "@/lib/modules/payment-methods/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import {
  fieldTypeCurrency,
  fieldType,
  paymentMethodField,
  categoryField,
  dateField,
} from "@/lib/i18n/form-fields.ts";
import { displayCategoryName } from "@/lib/i18n/category-labels.ts";
import { displayPaymentMethodName } from "@/lib/i18n/payment-method-labels.ts";
import { lastYearWindow, lastDayOfMonth } from "@/lib/date.ts";
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";

interface Props {
  userId: string;
  locale: LocaleCode;
}

const { userId, locale } = Astro.props;
const t = getLocaleDict(locale);
const params = Astro.url.searchParams;
const filterType = params.get("type") || "all";
const filterMonth = params.get("month") || "";
const filterQ = params.get("q") || "";
const filterPm = params.get("payment_method_id") || "";
const filterCat = params.get("category_id") || "";
const pmRepo = new PaymentMethodRepository();
const catRepo = new CategoryRepository();
const repo = new TransactionRepository();
const txFilter: Record<string, unknown> = {};
if (filterType !== "all") txFilter.type = filterType;
if (filterMonth) txFilter.month = filterMonth;
if (filterQ) txFilter.q = filterQ;
if (filterPm) txFilter.payment_method_id = filterPm;
if (filterCat) txFilter.category_id = filterCat;
if (!filterMonth) {
  const { from, to } = lastYearWindow(Astro.locals.createdAt);
  txFilter.date_from = `${from}-01`;
  txFilter.date_to = lastDayOfMonth(to);
  txFilter.limit = 200;
}
const [paymentMethods, txCategories, initialData] = await Promise.all([
  pmRepo.findAll(userId),
  catRepo.findBySections(userId, ["transactions"]),
  repo.findAll(userId, txFilter),
]);
const fields = [
  dateField(t),
  fieldType(t),
  {
    name: "description",
    label: t.field.description,
    type: "text" as const,
  },
  {
    name: "amount",
    label: t.field.amount,
    type: "number" as const,
    required: true,
    step: "0.01",
  },
  fieldTypeCurrency(t),
  paymentMethodField(t, paymentMethods),
  categoryField(t, txCategories),
];
const defaultForm = {
  type: "expense",
  description: "",
  amount: 0,
  currency: "MXN",
  payment_method_id: paymentMethods[0]?.id ?? "",
  category_id: "",
  date: "",
};
---

<div data-module="transactions" class="space-y-4">
  <PageHeader
    title={t.page.transactions}
    createLabel={t.cta.newTransaction}
    createModule="transactions"
    mobileOnlyCTA={true}
  />
  <TransactionsFilterable
    client:load
    initialMonth={filterMonth}
    createdAt={Astro.locals.createdAt}
    filterType={filterType}
    paymentMethods={paymentMethods.map((pm) => ({
      id: pm.id,
      icon: pm.icon,
      name: displayPaymentMethodName(pm, t),
    }))}
    categories={txCategories.map((c) => ({
      id: c.id,
      icon: c.icon,
      name: displayCategoryName(c, t),
    }))}
    initialData={JSON.stringify(initialData)}
    locale={locale}
  />
</div>
<CrudModal
  client:load
  module="transactions"
  fields={JSON.stringify(fields)}
  defaultForm={JSON.stringify(defaultForm)}
  titleSingular={t.singular.transaction}
  locale={locale}
/>
<DeleteHandler module="transactions" label={t.singular.transaction} />