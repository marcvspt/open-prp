---
import { BTN_EDIT, BTN_DELETE } from "@/lib/i18n/general-fields.ts";
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";
import { FILTER_ALL_MONTHS } from "@/lib/i18n/filter-fields.ts";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DataTable from "@/components/app/ui/DataTable.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import TabBarWithMonth from "@/components/app/ui/TabBarWithMonth.tsx";
import CreditCardSummary from "@/components/app/cards/CreditCardSummary.tsx";
import CardsHistory from "@/components/app/cards/CardsHistory.tsx";
import { CardRepository } from "@/lib/modules/cards/repository.ts";
import { CardMonthlyRepository } from "@/lib/modules/card-monthly/repository.ts";
import { PaymentMethodRepository } from "@/lib/modules/payment-methods/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { currentMonthStr, resolvePaymentDueDate as resolvePaymentDueDateISO, lastYearWindow } from "@/lib/date.ts";

interface Props {
  userId: string;
  locale: LocaleCode;
}

const { userId, locale } = Astro.props;
const t = getLocaleDict(locale);
const paramMonth = Astro.url.searchParams.get("month");
const urlMonth = paramMonth && /^\d{4}-\d{2}$/.test(paramMonth) ? paramMonth : "";
const currentMonth = urlMonth || currentMonthStr();

const paramTab = Astro.url.searchParams.get("tab");
const initialTab = paramTab === "admin" ? "admin" : paramTab === "history" ? "history" : "summary";

const cardMonthlyRepo = new CardMonthlyRepository();
const { from: fromMonth, to: nextMonth } = lastYearWindow(Astro.locals.createdAt);
const [cards, cardDebts, fullHistory, paymentMethods, categories] = await Promise.all([
  new CardRepository().findAll(userId),
  cardMonthlyRepo.findByMonth(currentMonth, userId),
  cardMonthlyRepo.getHistory(userId),
  new PaymentMethodRepository().findAll(userId),
  new CategoryRepository().findAll(userId),
]);
const cardHistory = urlMonth ? fullHistory.filter(d => d.month === currentMonth) : fullHistory.filter(d => d.month >= fromMonth && d.month <= nextMonth);

const calculatedDebts = {};

const now = new Date();
const currentYear = now.getFullYear();
const month = now.getMonth() + 1;

function resolveDate(day: number, baseYear: number, baseMonth: number): string {
  const d = new Date(baseYear, baseMonth - 1, day);
  return d.toLocaleDateString(locale, { day: "numeric", month: "long" });
}

function resolvePaymentDueDate(cutoffDay: number, paymentDueDay: number): string {
  const monthStr = `${currentYear}-${String(month).padStart(2, "0")}`;
  const [y, m, d] = resolvePaymentDueDateISO(monthStr, cutoffDay, paymentDueDay).split("-").map(Number);
  return resolveDate(d, y, m);
}

function resolveCutoffDate(cutoffDay: number): string {
  return resolveDate(cutoffDay, currentYear, month);
}

const fields = [
  { name: "name", label: t.field.name, type: "text" as const, required: true },
  { name: "type", label: t.field.type, type: "select" as const, required: true, options: [{ value: "credit", label: t.badge.credit }, { value: "debit", label: t.badge.debit }, { value: "voucher", label: t.badge.voucherFull }] },
  { name: "max_limit", label: t.field.maxLimit, type: "number" as const, step: "0.01", showIf: { field: "type", value: "credit" } },
  { name: "cutoff_day", label: t.field.cutoffDay, type: "number" as const, min: 1, showIf: { field: "type", value: "credit" } },
  { name: "payment_due_day", label: t.field.paymentDueDay, type: "number" as const, min: 1, showIf: { field: "type", value: "credit" } },
  { name: "color", label: t.field.color, type: "color" as const },
];
const defaultForm = { name: "", type: "credit", max_limit: 0, cutoff_day: 15, payment_due_day: 10, color: "#6366f1" };
---

<div data-module="cards" class="space-y-4">
  <PageHeader title={t.page.cards} />
  <div class="tabs-container">
    <TabBarWithMonth
      client:load
      tabs={[{ key: "summary", label: t.tabs.summary }, { key: "admin", label: t.tabs.adminCards }, { key: "history", label: t.tabs.history }]}
      initialTab={initialTab}
      defaultTab="summary"
      ariaLabel={t.cards.ariaTabs}
      initialMonth={urlMonth}
      createdAt={Astro.locals.createdAt}
      allLabel={FILTER_ALL_MONTHS(t)}
      locale={locale}
    />
    <div data-tab-content="summary" role="tabpanel" id="panel-summary" aria-labelledby="tab-summary" tabindex="0" class:list={["tab-content pt-4", { hidden: initialTab !== "summary" }]}>
      <CreditCardSummary
        client:load
        initialCards={JSON.stringify(cards)}
        initialDebts={JSON.stringify(cardDebts)}
        initialCalculated={JSON.stringify(calculatedDebts)}
        initialPaymentMethods={JSON.stringify(paymentMethods)}
        initialCategories={JSON.stringify(categories)}
        initialMonth={currentMonth}
        locale={locale}
      />
    </div>
    <div data-tab-content="admin" role="tabpanel" id="panel-admin" aria-labelledby="tab-admin" tabindex="0" class:list={["tab-content pt-4", { hidden: initialTab !== "admin" }]}>
      <div class="flex items-center justify-between mb-4">
        <p class="text-sm text-string-muted">{t.cards.allCardsRegistered}</p>
        <button data-create="cards" class="px-3 py-1.5 text-sm font-medium rounded-lg bg-primary text-white hover:bg-primary-hover cursor-pointer">{t.cta.newCard}</button>
      </div>
      <DataTable columns={[t.table.name, t.table.type, { label: t.table.limit, align: "right" }, { label: t.table.cutoff, align: "center" }, { label: t.table.dueDay, align: "center" }, { label: t.table.actions, align: "right" }]} emptyMessage={t.empty.cards}>
        {cards.map(c => {
          const typeLabel = c.type === "credit" ? t.badge.credit : c.type === "debit" ? t.badge.debit : t.badge.voucher;
          const typeColor = c.type === "credit" ? "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" : c.type === "debit" ? "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300" : "bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300";
          return (
          <tr class="hover:bg-nav-hover">
            <td class="px-4 py-3"><span class="flex items-center gap-2">{c.color && <span class="w-3 h-3 rounded-full" style={{ backgroundColor: c.color }} />}{c.name}</span></td>
            <td class="px-4 py-3"><span class={`text-xs font-medium px-2 py-0.5 rounded ${typeColor}`}>{typeLabel}</span></td>
            <td class="px-4 py-3 text-right font-mono text-success">{c.max_limit != null ? `$${Number(c.max_limit).toFixed(2)}` : "—"}</td>
            <td class="px-4 py-3 text-center text-xs font-semibold">{c.cutoff_day != null ? resolveCutoffDate(c.cutoff_day) : "—"}</td>
            <td class="px-4 py-3 text-center text-xs font-semibold">{c.cutoff_day != null && c.payment_due_day != null ? resolvePaymentDueDate(c.cutoff_day, c.payment_due_day) : "—"}</td>
            <td class="px-4 py-3 text-right space-x-2">
              <button data-edit-cards={c.id} class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer">{BTN_EDIT(t)}</button>
              <button data-delete-cards={c.id} class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer">{BTN_DELETE(t)}</button>
            </td>
          </tr>
          );
        })}
      </DataTable>
    </div>
    <div data-tab-content="history" role="tabpanel" id="panel-history" aria-labelledby="tab-history" tabindex="0" class:list={["tab-content pt-4", { hidden: initialTab !== "history" }]}>
      <CardsHistory
        client:load
        initialData={JSON.stringify(cardHistory)}
        initialCards={JSON.stringify(cards)}
        locale={locale}
      />
    </div>
  </div>
</div>
<CrudModal client:load module="cards" fields={JSON.stringify(fields)} defaultForm={JSON.stringify(defaultForm)} titleSingular={t.singular.card} locale={locale} />
<DeleteHandler module="cards" label={t.singular.card} />