---
import { getRelativeLocaleUrl } from "astro:i18n";
import { BTN_EDIT, BTN_DELETE } from "@/lib/i18n/general-fields.ts";
import { FILTER_WRAP_CLASS, FILTER_ALL_STATUS_TASKS } from "@/lib/i18n/filter-fields.ts";
import { formatDate } from "@/lib/date.ts";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import ToggleHandler from "@/components/app/ui/ToggleHandler.astro";
import FilterLinks from "@/components/app/ui/FilterLinks.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { TaskRepository } from "@/lib/modules/tasks/repository.ts";
import { CategoryRepository } from "@/lib/modules/transactions/categories.ts";
import { displayCategoryName } from "@/lib/i18n/category-labels.ts";
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";

interface Props {
  userId: string;
  locale: LocaleCode;
}

const { userId, locale } = Astro.props;
const t = getLocaleDict(locale);
const tasksUrl = getRelativeLocaleUrl(locale, "/app/tasks");
const filter = Astro.url.searchParams.get("filter") || "all";
const q: Record<string, unknown> = {};
if (filter === "pending") q.is_completed = false;
if (filter === "done") q.is_completed = true;
const [items, categories] = await Promise.all([
  new TaskRepository().findAll(userId, q),
  new CategoryRepository().findBySections(userId, ["tasks"]),
]);
const catMap = Object.fromEntries(categories.map((c) => [c.id, c]));
const catOptions = [
  { value: "", label: t.field.noCategory },
  ...categories.map((c) => ({
    value: c.id,
    label: `${c.icon || "📋"} ${displayCategoryName(c, t)}`,
  })),
];
const priorityLabels: Record<number, string> = {
  1: t.badge.low,
  2: t.badge.medium,
  3: t.badge.high,
};
const priorityColor: Record<number, string> = {
  1: "bg-success-bg text-success-text",
  2: "bg-warning-bg text-warning-text",
  3: "bg-danger-bg text-danger-text",
};
const fields = [
  {
    name: "description",
    label: t.field.description,
    type: "textarea" as const,
    required: true,
  },
  { name: "due_date", label: t.field.dueDate, type: "date" as const },
  {
    name: "priority",
    label: t.field.priority,
    type: "select" as const,
    options: [
      { value: "1", label: t.badge.lowOption },
      { value: "2", label: t.badge.mediumOption },
      { value: "3", label: t.badge.highOption },
    ],
  },
  {
    name: "category",
    label: t.field.category,
    type: "select" as const,
    options: catOptions,
  },
];
const defaultForm = {
  description: "",
  due_date: "",
  priority: 1,
  category: "",
};
const taskFilters = [
  { value: "all", label: FILTER_ALL_STATUS_TASKS(t), href: tasksUrl },
  {
    value: "pending",
    label: t.filter.pendingTasks,
    href: `${tasksUrl}?filter=pending`,
  },
  {
    value: "done",
    label: t.filter.doneTasks,
    href: `${tasksUrl}?filter=done`,
  },
];
---

<div data-module="tasks" class="space-y-4">
  <PageHeader
    title={t.page.tasks}
    createLabel={t.cta.newTask}
    createModule="tasks"
    mobileOnlyCTA={true}
  />
  <div
    class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between"
  >
    <FilterLinks
      filters={taskFilters}
      active={filter}
      class={FILTER_WRAP_CLASS}
      locale={locale}
    />
    <button
      data-create="tasks"
      class="hidden sm:block sm:shrink-0 px-3 py-2 text-sm font-medium rounded-lg bg-primary text-white hover:bg-primary-hover cursor-pointer"
      >{t.cta.newTask}</button
    >
  </div>
  {
    items.length === 0 ? (
      <div class="text-string-muted text-sm">{t.empty.tasks}</div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {items.map((task) => {
          const cat = task.category && catMap[task.category];
          return (
            <div
              class={`relative rounded-xl border p-4 transition-all hover:shadow-sm ${
                task.is_completed
                  ? "border-success-border bg-success-border/10 opacity-60"
                  : "border-border bg-panel"
              }`}
            >
              <div class="flex items-start gap-3 mb-2">
                <input
                  type="checkbox"
                  checked={task.is_completed}
                  data-toggle-tasks={task.id}
                  class="mt-0.5 w-4 h-4 accent-primary cursor-pointer shrink-0"
                />
                <div class="flex-1 min-w-0">
                  <div
                    class={`text-sm leading-snug ${task.is_completed ? "line-through text-string-muted" : "font-medium text-string"}`}
                  >
                    {task.description}
                  </div>
                </div>
                <span
                  class={`shrink-0 text-xs px-2 py-0.5 rounded font-medium ${priorityColor[task.priority] || "bg-surface-alt text-string-muted"}`}
                >
                  {priorityLabels[task.priority] || "⚪"}
                </span>
              </div>
              <div class="flex items-center gap-3 text-xs text-string-muted ml-7">
                {cat && (
                  <span>
                    {cat.icon || "📋"} {displayCategoryName(cat, t)}
                  </span>
                )}
                {task.due_date && (
                  <span class="font-semibold">
                    📅 {formatDate(task.due_date, locale)}
                  </span>
                )}
              </div>
              <div class="flex justify-end gap-2 mt-3 pt-2 border-t border-border ml-7">
                <button
                  data-edit-tasks={task.id}
                  class="text-primary hover:text-primary-hover text-xs font-medium cursor-pointer"
                >
                  {BTN_EDIT(t)}
                </button>
                <button
                  data-delete-tasks={task.id}
                  class="text-danger hover:text-danger-hover text-xs font-medium cursor-pointer"
                >
                  {BTN_DELETE(t)}
                </button>
              </div>
            </div>
          );
        })}
      </div>
    )
  }
</div>
<CrudModal
  client:load
  module="tasks"
  fields={JSON.stringify(fields)}
  defaultForm={JSON.stringify(defaultForm)}
  titleSingular={t.singular.task}
  locale={locale}
/>
<DeleteHandler module="tasks" label={t.singular.task} />
<ToggleHandler module="tasks" key="is_completed" />