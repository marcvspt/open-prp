---
export interface Props {
  title: string;
  createLabel?: string;
  createModule?: string;
}

const { title, createLabel, createModule } = Astro.props;
---

<div class="flex items-center justify-between flex-wrap gap-2">
  <h1 class="text-2xl font-bold text-string">{title}</h1>
  {createLabel && createModule && (
    <button data-create={createModule} class="px-4 py-2 bg-primary text-white text-sm rounded-lg hover:bg-primary-hover cursor-pointer">{createLabel}</button>
  )}
  {!createLabel && <slot name="actions" />}
</div>
