---
import { Show, UserButton } from "@clerk/astro/components";
import { getRelativeLocaleUrl } from "astro:i18n";
import ThemeToggle from "@/components/ui/ThemeToggle.tsx";
import LocaleSwitcher from "@/components/ui/LocaleSwitcher.tsx";
import CurrencySelect from "@/components/app/ui/CurrencySelect.tsx";
import { getLocaleDict } from "@/lib/i18n/locale.ts";
import HomeIcon from "@/assets/home.svg";
import DollarIcon from "@/assets/dollar.svg";
import CardIcon from "@/assets/card.svg";
import ClipboardIcon from "@/assets/clipboard.svg";
import RecurringIcon from "@/assets/recurring.svg";
import WalletIcon from "@/assets/wallet.svg";
import CartIcon from "@/assets/cart.svg";
import PenIcon from "@/assets/pen.svg";
import CalendarIcon from "@/assets/calendar.svg";
import PackageIcon from "@/assets/package.svg";
import TagIcon from "@/assets/tag.svg";
import GithubIcon from "@/assets/github.svg";

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const locale = Astro.currentLocale ?? "es";
const t = getLocaleDict(locale);
const preferredCurrency = Astro.locals.user?.preferred_currency ?? "MXN";

interface AppLink {
  url: string;
  label: string;
  icon: typeof HomeIcon;
}

const appUrl = (path: string) => getRelativeLocaleUrl(locale, path);

const APP_LINKS: { title?: string; links: AppLink[] }[] = [
  {
    links: [{ url: appUrl("/app/dashboard"), label: t.nav.dashboard, icon: HomeIcon }],
  },
  {
    title: t.nav.groupFinance,
    links: [
      { url: appUrl("/app/transactions"), label: t.nav.transactions, icon: DollarIcon },
      { url: appUrl("/app/cards"), label: t.nav.cards, icon: CardIcon },
      { url: appUrl("/app/installments"), label: t.nav.installments, icon: ClipboardIcon },
      {
        url: appUrl("/app/recurring-payments"),
        label: t.nav.recurringPayments,
        icon: RecurringIcon,
      },
      { url: appUrl("/app/cashback"), label: t.nav.cashback, icon: DollarIcon },
      {
        url: appUrl("/app/payment-methods"),
        label: t.nav.paymentMethods,
        icon: WalletIcon,
      },
    ],
  },
  {
    title: t.nav.groupOrganization,
    links: [
      { url: appUrl("/app/shopping"), label: t.nav.shopping, icon: CartIcon },
      { url: appUrl("/app/tasks"), label: t.nav.tasks, icon: ClipboardIcon },
      { url: appUrl("/app/notes"), label: t.nav.notes, icon: PenIcon },
      { url: appUrl("/app/events"), label: t.nav.events, icon: CalendarIcon },
      { url: appUrl("/app/pantry"), label: t.nav.pantry, icon: PackageIcon },
    ],
  },
  {
    title: t.nav.groupGeneral,
    links: [{ url: appUrl("/app/categories"), label: t.nav.categories, icon: TagIcon }],
  },
];
---

<aside
  id="sidebar"
  class="fixed left-0 top-0 z-40 flex h-full w-64 flex-col border-r border-border bg-panel transition-transform duration-300 -translate-x-full lg:translate-x-0"
>
  <div
    class="flex h-16 items-center justify-between px-4 border-b border-border shrink-0"
  >
    <span class="text-lg font-bold">Open PRP</span>
    <a
      href="https://github.com/marcvspt/open-prp"
      target="_blank"
      rel="noopener"
      class="text-string-muted hover:text-primary transition-colors"
      aria-label={t.nav.ariaGithub}
    >
      <GithubIcon class="w-4 h-4" />
    </a>
  </div>

  <nav aria-label={t.nav.ariaMain} class="flex-1 space-y-1 overflow-y-auto p-2 text-sm">
    {
      APP_LINKS.map((group) => (
        <>
          {group.title && (
            <div class="pt-3 pb-1 px-3 text-xs font-semibold text-string-muted uppercase tracking-wider">
              {group.title}
            </div>
          )}
          {group.links.map(({ url, label, icon: Icon }) => (
            <a
              href={url}
              class={`flex items-center gap-3 px-3 py-2.5 rounded-lg transition ${currentPath.startsWith(url) ? "bg-nav-active text-nav-active-text font-medium" : "text-nav hover:bg-nav-hover"}`}
            >
              <Icon aria-hidden="true" class="w-5 h-5 shrink-0" />
              <span>{label}</span>
            </a>
          ))}
        </>
      ))
    }
  </nav>

  <div class="border-t border-border p-3 space-y-2 shrink-0">
    <div class="px-3">
      <LocaleSwitcher client:load locale={locale} />
    </div>
    <div class="px-3">
      <ThemeToggle client:load locale={locale} />
    </div>
    <div class="px-3">
      <CurrencySelect client:load initialCurrency={preferredCurrency} locale={locale} />
    </div>
    <Show when="signed-in">
      <div
        class="flex items-center gap-3 px-3 py-2 cursor-pointer"
        data-user-area
      >
        {/* Caja fija: reserva el espacio del avatar (ClerkJS lo monta asíncrono) para evitar layout shift en el footer */}
        <div
          class="h-8 w-8 shrink-0 overflow-hidden rounded-full bg-surface-alt"
          transition:persist="user-button"
        >
          <UserButton
            appearance={{
              elements: {
                userButtonAvatarBox: { width: "2rem", height: "2rem" },
              },
            }}
          />
        </div>
        <span class="text-xs text-string-muted">{t.nav.myAccount}</span>
      </div>
    </Show>
  </div>
</aside>
