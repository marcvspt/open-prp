---
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";
export interface Props {
  module: string;
  key?: string;
  endpoint?: string;
}
const { module, key = "is_checked", endpoint = `/api/${module}/toggle` } = Astro.props;
const t = getLocaleDict(resolveLocale(Astro.currentLocale));
---
<span hidden data-toggle-config={module} data-toggle-endpoint={endpoint} data-toggle-key={key}></span>
<p hidden data-toggle-error role="alert" class="rounded-lg border border-danger-border bg-danger-bg px-3 py-2 text-sm text-danger-text">{t.common.errorUnknown}</p>
<script>
  import { initToggleHandler } from "@/lib/ui/toggle-handler.ts";
  initToggleHandler();
</script>
