---
import FilterSelect from "@/components/app/ui/FilterSelect.tsx";
import type { LocaleCode } from "@/lib/i18n/locale.ts";

export interface FilterLink {
  value: string;
  label: string;
  href: string;
}

export interface Props {
  filters: FilterLink[];
  active: string;
  class?: string;
  locale?: LocaleCode;
}

const { filters, active, class: className, locale } = Astro.props;
---

<FilterSelect filters={filters} active={active} className={className} locale={locale} client:load />
