---
import FilterSelect from "@/components/app/ui/FilterSelect.tsx";

export interface FilterLink {
  value: string;
  label: string;
  href: string;
}

export interface Props {
  filters: FilterLink[];
  active: string;
  class?: string;
}

const { filters, active, class: className } = Astro.props;
---

<FilterSelect filters={filters} active={active} className={className} client:load />