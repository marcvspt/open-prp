---
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";

type Column = string | { label: string; align?: "left" | "right" | "center" };

export interface Props {
  columns: Column[];
  emptyMessage?: string;
  ariaLabel?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const t = getLocaleDict(locale);
const { columns, emptyMessage = t.empty.data, ariaLabel } = Astro.props;
const colCount = columns.length;

const alignMap: Record<string, string> = { left: "text-left", right: "text-right", center: "text-center" };
---

<div class="overflow-x-auto rounded-lg border border-border">
  <table aria-label={ariaLabel} class="min-w-full divide-y divide-border text-sm">
    <thead class="bg-surface-alt">
      <tr>
        {columns.map(col => {
          const label = typeof col === "string" ? col : col.label;
          const align = alignMap[typeof col === "string" ? "left" : col.align ?? "left"];
          return <th class={`px-4 py-3 ${align} font-medium text-string-muted uppercase tracking-wider`}>{label}</th>;
        })}
      </tr>
    </thead>
    <tbody class="divide-y divide-border-light">
      {Astro.slots.has("default") ? (
        <slot />
      ) : (
        <tr><td colspan={colCount} class="px-4 py-8 text-center text-string-muted">{emptyMessage}</td></tr>
      )}
    </tbody>
  </table>
</div>
