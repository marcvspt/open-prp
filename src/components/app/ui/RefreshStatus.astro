---
import LoadingSpinner from "@/components/app/ui/LoadingSpinner.tsx";
import { getLocaleDict, resolveLocale } from "@/lib/i18n/locale.ts";
const t = getLocaleDict(resolveLocale(Astro.currentLocale));
---
<div data-refresh-status>
  <div role="status" aria-atomic="true">
    <div data-refresh-state="loading" hidden class="pointer-events-none fixed bottom-4 right-4 z-40 rounded-full border border-border bg-panel p-2.5 shadow-lg">
      <LoadingSpinner className="flex" />
      <span class="sr-only">{t.common.refreshing}</span>
    </div>
  </div>
  <div data-refresh-state="error" hidden class="fixed bottom-4 right-4 left-4 sm:left-auto z-40 max-w-sm rounded-lg border border-border bg-panel px-4 py-3 text-sm shadow-lg">
    <p role="alert">{t.error.refreshData}</p>
    <button type="button" data-refresh-retry class="mt-2 font-medium text-primary hover:text-primary-hover cursor-pointer">{t.common.retry}</button>
  </div>
</div>
