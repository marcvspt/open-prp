---
import { BTN_EDIT, BTN_DELETE } from "@/lib/i18n/general-fields.ts";
import { formatDate } from "@/lib/date.ts";
import PageHeader from "@/components/app/ui/PageHeader.astro";
import DeleteHandler from "@/components/app/ui/DeleteHandler.astro";
import CrudModal from "@/components/app/ui/CrudModal.tsx";
import { NoteRepository } from "@/lib/modules/notes/repository.ts";
import { getLocaleDict, type LocaleCode } from "@/lib/i18n/locale.ts";

interface Props {
  userId: string;
  locale: LocaleCode;
}

const { userId, locale } = Astro.props;
const t = getLocaleDict(locale);
const items = (await new NoteRepository().findAll(userId)) ?? [];

const colorMap: Record<string, string> = {
  blue: "#3b82f6",
  green: "#22c55e",
  yellow: "#eab308",
  pink: "#ec4899",
  purple: "#a855f7",
};

const fields = [
  { name: "title", label: t.field.title, type: "text" as const },
  { name: "content", label: t.field.content, type: "textarea" as const },
  { name: "color", label: t.field.color, type: "color" as const },
  { name: "is_pinned", label: t.field.pinned, type: "checkbox" as const },
];
const defaultForm = { title: "", content: "", color: "", is_pinned: false };
---

<div data-module="notes" class="space-y-4">
  <PageHeader
    title={t.page.notes}
    createLabel={t.cta.newNote}
    createModule="notes"
  />
  {
    items.length === 0 ? (
      <p class="text-center text-string-muted py-8">{t.empty.notes}</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.map((note) => {
          const raw = note.color ?? "";
          const hex = raw.startsWith("#") ? raw : (colorMap[raw] ?? "");
          const hasColor = !!hex;
          return (
            <div
              class={`rounded-xl p-4 shadow-sm border border-border bg-panel ${hasColor ? "border-l-4" : ""} ${note.is_pinned ? "ring-2 ring-primary-border" : ""}`}
              style={
                hasColor
                  ? `border-left-color: ${hex}; background-color: ${hex}08`
                  : ""
              }
            >
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-semibold text-string truncate">
                  {note.title || t.empty.noTitle}
                </h3>
                <div class="flex gap-1 shrink-0">
                  <button
                    data-edit-notes={note.id}
                    class="text-xs font-medium text-primary hover:text-primary-hover cursor-pointer"
                  >
                    {BTN_EDIT(t)}
                  </button>
                  <button
                    data-delete-notes={note.id}
                    class="text-xs font-medium text-danger hover:text-danger-hover cursor-pointer"
                  >
                    {BTN_DELETE(t)}
                  </button>
                </div>
              </div>
              {note.content && (
                <p class="mt-2 text-sm text-nav whitespace-pre-wrap line-clamp-3">
                  {note.content}
                </p>
              )}
              <div class="mt-3 text-xs text-string-muted">
                {formatDate(note.updated_at, locale)}
              </div>
            </div>
          );
        })}
      </div>
    )
  }
</div>
<CrudModal
  client:load
  module="notes"
  fields={JSON.stringify(fields)}
  defaultForm={JSON.stringify(defaultForm)}
  titleSingular={t.singular.note}
  locale={locale}
/>
<DeleteHandler module="notes" label={t.singular.note} />